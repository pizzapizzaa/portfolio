  <main class="main-content">
    <div class="welcome-wrap">
      <div class="tx-tag" aria-hidden="true">INCOMING TRANSMISSION</div>

      <div class="welcome-panel" role="main">
        <div class="corner-tr" aria-hidden="true"></div>
        <div class="corner-bl" aria-hidden="true"></div>

        <div class="welcome-text">
          <p class="salutation">Dear explorer,</p>
          <p>You&rsquo;ve come to the right place. This place contains a number of products across the globe from Olivia Nguyen.</p>
          <p class="ready-line">Ready to get started?</p>
        </div>

        <form id="explorerForm" novalidate>
          <div class="form-group">
            <label class="form-label" for="nickname">Enter your explorer nickname</label>
            <input
              type="text"
              id="nickname"
              name="nickname"
              class="game-input"
              placeholder="e.g. StarNavigator_99"
              maxlength="24"
              autocomplete="off"
              spellcheck="false"
            />
          </div>

          <div class="form-group">
            <label class="form-label">Select your starting server</label>
            <div class="game-dropdown" id="serverDropdown"
                 role="combobox" aria-expanded="false" aria-haspopup="listbox"
                 aria-controls="serverMenu" tabindex="0">
              <div class="gd-trigger">
                <span class="gd-selected placeholder" id="serverDisplay">&#8212; Choose your continent &#8212;</span>
                <svg class="gd-arrow" xmlns="http://www.w3.org/2000/svg" width="12" height="8" viewBox="0 0 12 8" aria-hidden="true">
                  <path d="M1 1l5 5 5-5" stroke="#92D34F" stroke-width="2" fill="none" stroke-linecap="round"/>
                </svg>
              </div>
              <ul class="gd-menu" role="listbox" id="serverMenu">
                <li class="gd-option" role="option" data-value="africa">🌍 Africa</li>
                <li class="gd-option" role="option" data-value="antarctica">🧊 Antarctica</li>
                <li class="gd-option" role="option" data-value="asia">🌏 Asia</li>
                <li class="gd-option" role="option" data-value="australia">🌊 Australia &amp; Oceania</li>
                <li class="gd-option" role="option" data-value="europe">🏛 Europe</li>
                <li class="gd-option" role="option" data-value="north-america">🗽 North America</li>
                <li class="gd-option" role="option" data-value="south-america">🌿 South America</li>
              </ul>
            </div>
            <input type="hidden" id="server" name="server" />
          </div>

          <div class="cta-row">
            <button type="submit" class="cta-btn">
              <span>Let&rsquo;s Explore</span>
            </button>
          </div>
        </form>
      </div>
    </div>
