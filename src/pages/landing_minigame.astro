  <script>
    // Theme
    const html      = document.documentElement;
    const themeIcon = document.getElementById('themeIcon');

    function applyTheme(t) {
      html.setAttribute('data-theme', t);
      themeIcon.textContent = t === 'dark' ? '\u{1F319}' : '\u2600\uFE0F';
      try { localStorage.setItem('ex-theme', t); } catch (_) {}
    }

    try { applyTheme(localStorage.getItem('ex-theme') || 'dark'); } catch(_) { applyTheme('dark'); }
    document.getElementById('btnTheme').addEventListener('click', () => {
      applyTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });

    // Modal helpers
    function openModal(id)  { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); }

    function bindClose(modalId, closeBtnId) {
      const overlay = document.getElementById(modalId);
      document.getElementById(closeBtnId).addEventListener('click', () => closeModal(modalId));
      overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(modalId); });
      overlay.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(modalId); });
    }

    // World Map
    document.getElementById('btnWorldMap').addEventListener('click', () => openModal('worldMapModal'));
    bindClose('worldMapModal', 'closeWorldMap');

    const markerNav = {
      'mArkeamerica': '/projects/e-america',
      'm-eamerica':   '/projects/e-america',
      'm-mb':         '/projects/mbfs-sea',
      'm-sg':         '/projects/verity-nature',
      'm-vn':         '/projects/boulder-box-saigon',
      'm-au':         '/projects/mbfs-au',
    };

    document.querySelectorAll('.proj-marker').forEach(el => {
      const go = () => { const h = markerNav[el.id]; if (h) window.location.href = h; };
      el.addEventListener('click', go);
      el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') go(); });
    });

    // Settings
    document.getElementById('btnSettings').addEventListener('click', () => {
      try {
        document.getElementById('settingsNickname').value = localStorage.getItem('ex-nickname') || '';
        const saved = localStorage.getItem('ex-marker') || 'pin';
        document.querySelectorAll('.marker-opt').forEach(b => b.classList.toggle('sel', b.dataset.marker === saved));
      } catch(_) {}
      openModal('settingsModal');
    });

    bindClose('settingsModal', 'closeSettings');

    document.getElementById('markerGrid').addEventListener('click', e => {
      const btn = e.target.closest('.marker-opt');
      if (!btn) return;
      document.querySelectorAll('.marker-opt').forEach(b => b.classList.remove('sel'));
      btn.classList.add('sel');
    });

    document.getElementById('saveSettings').addEventListener('click', () => {
      const nick   = document.getElementById('settingsNickname').value.trim();
      const marker = document.querySelector('.marker-opt.sel')?.dataset.marker || 'pin';
      try {
        if (nick) { localStorage.setItem('ex-nickname', nick); document.getElementById('nickname').value = nick; }
        localStorage.setItem('ex-marker', marker);
      } catch(_) {}
      closeModal('settingsModal');
    });

    // Explorer Form
    try { const s = localStorage.getItem('ex-nickname'); if (s) document.getElementById('nickname').value = s; } catch(_) {}

    document.getElementById('explorerForm').addEventListener('submit', e => {
      e.preventDefault();
      const nick   = document.getElementById('nickname').value.trim();
      const server = document.getElementById('server').value;

      function shake(id) {
        const el = document.getElementById(id);
        el.focus();
        el.style.borderColor = '#ff6b6b';
        el.style.boxShadow   = '0 0 12px rgba(255,107,107,0.4)';
        setTimeout(() => { el.style.borderColor = ''; el.style.boxShadow = ''; }, 1800);
      }

      if (!nick)   { shake('nickname'); return; }
      if (!server) { shake('server');   return; }

      try { localStorage.setItem('ex-nickname', nick); localStorage.setItem('ex-server', server); } catch(_) {}
      openModal('worldMapModal');
    });

    // Saucer cursor + gas trail
    (function () {
      const cur    = document.getElementById('saucer-cursor');
      const canvas = document.getElementById('trail-canvas');
      const ctx    = canvas.getContext('2d');

      function resize() {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      // Cursor position tracking
      let cx = -500, cy = -500;  // current
      let px = -500, py = -500;  // previous (for velocity)
      let curRaf = null;

      // Particle pool
      const particles = [];

      document.addEventListener('mousemove', e => {
        px = cx; py = cy;
        cx = e.clientX; cy = e.clientY;

        // Move saucer
        if (!curRaf) curRaf = requestAnimationFrame(() => {
          curRaf = null;
          cur.style.left = cx + 'px';
          cur.style.top  = cy + 'px';
        });

        // Spawn trail particles from saucer underside
        // Underside hotspot: cx + 0, cy + 10  (saucer SVG offset is -20px,-12px; underside at cy=21)
        const ox = cx;
        const oy = cy + 9;
        const dx = cx - px;
        const dy = cy - py;
        const speed = Math.sqrt(dx * dx + dy * dy);
        const count = Math.min(2 + Math.floor(speed * 0.25), 7);

        for (let i = 0; i < count; i++) {
          const spread = (Math.random() - 0.5) * 6;
          // Trail velocity: opposite to movement direction + spread
          const invSpeed = speed > 0.5 ? 1 / speed : 0;
          const tvx = speed > 0.5
            ? (-dx * invSpeed) * (0.6 + Math.random() * 1.2) + (Math.random() - 0.5) * 1.2
            : (Math.random() - 0.5) * 1.4;
          const tvy = speed > 0.5
            ? (-dy * invSpeed) * (0.6 + Math.random() * 1.2) + Math.random() * 1.0
            : Math.random() * 1.2 + 0.4;

          particles.push({
            x:     ox + spread,
            y:     oy,
            vx:    tvx,
            vy:    tvy,
            life:  1.0,
            decay: 0.022 + Math.random() * 0.030,
            size:  2.5 + Math.random() * 3.5,
            hue:   82 + Math.random() * 38,   // yellow-green → mint
            sat:   72 + Math.random() * 28,
          });
        }
      });

      document.addEventListener('mouseenter', () => cur.classList.add('visible'));
      document.addEventListener('mouseleave', () => cur.classList.remove('visible'));
      document.addEventListener('mousemove',  () => cur.classList.add('visible'), { once: true });

      // Render loop
      function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x    += p.vx;
          p.y    += p.vy;
          p.vy   += 0.06;          // gravity drip
          p.life -= p.decay;
          p.size *= 0.968;

          if (p.life <= 0 || p.size < 0.4) { particles.splice(i, 1); continue; }

          const r   = p.size * 2.8;
          const grd = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
          grd.addColorStop(0,   `hsla(${p.hue},${p.sat}%,78%,${p.life * 0.30})`);
          grd.addColorStop(0.35,`hsla(${p.hue},${p.sat}%,62%,${p.life * 0.14})`);
          grd.addColorStop(1,   `hsla(${p.hue},${p.sat}%,50%,0)`);

          ctx.beginPath();
          ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
          ctx.fillStyle = grd;
          ctx.fill();
        }

        requestAnimationFrame(loop);
      }
      loop();
    })();
  </script>
  <div class="footer-brand" aria-hidden="true">EXPLORER MODE v1.0</div>
</body>
</html>
