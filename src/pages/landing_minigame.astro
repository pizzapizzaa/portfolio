---
// Explorer Mode — standalone landing minigame page
// Fonts: Orbitron + Exo 2 (Google Fonts, SIL OFL — commercial-free)
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Explorer Mode — Olivia Nguyen Portfolio" />
  <title>Explorer Mode — Olivia Nguyen</title>

  <!-- Commercial-free gaming fonts (SIL Open Font License via Google Fonts) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Exo+2:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <style>
    /* =============================================
       THEME VARIABLES
    ============================================= */
    :root {
      --bg:         #05090e;
      --bg-panel:   rgba(10,22,30,0.93);
      --bg-input:   rgba(5,20,15,0.65);
      --border:     #2F8986;
      --border-hi:  #92D34F;
      --accent:     #92D34F;
      --accent-hi:  #D3ED66;
      --accent-dim: #41B774;
      --text-1:     #F7FFC7;
      --text-2:     #7db05a;
      --text-muted: #3a6a3a;
      --glow:       rgba(146,211,79,0.32);
      --glow-teal:  rgba(47,137,134,0.38);
      --nav-bg:     rgba(3,8,12,0.96);
      --grid-line:  rgba(47,137,134,0.06);
    }

    [data-theme="light"] {
      --bg:         #dff0dd;
      --bg-panel:   rgba(218,242,218,0.94);
      --bg-input:   rgba(185,228,185,0.55);
      --border:     #2a7a77;
      --border-hi:  #4a9a28;
      --accent:     #2a6d0e;
      --accent-hi:  #3a8c20;
      --accent-dim: #2a7a50;
      --text-1:     #081408;
      --text-2:     #1d481d;
      --text-muted: #3a6a3a;
      --glow:       rgba(55,130,20,0.22);
      --glow-teal:  rgba(40,118,116,0.28);
      --nav-bg:     rgba(205,238,205,0.96);
      --grid-line:  rgba(40,118,116,0.08);
    }

    /* =============================================
       RESET & BASE
    ============================================= */
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    html, body {
      height: 100%;
      font-family: 'Exo 2', sans-serif;
      background-color: var(--bg);
      color: var(--text-1);
      overflow-x: hidden;
      transition: background-color 0.3s, color 0.3s;
      cursor: none;
    }

    body {
      min-height: 100vh;
      background-image:
        radial-gradient(ellipse at 18% 55%, rgba(47,137,134,0.09) 0%, transparent 52%),
        radial-gradient(ellipse at 82% 18%, rgba(146,211,79,0.07) 0%, transparent 50%),
        repeating-linear-gradient(0deg, transparent, transparent 47px, var(--grid-line) 47px, var(--grid-line) 48px),
        repeating-linear-gradient(90deg, transparent, transparent 47px, var(--grid-line) 47px, var(--grid-line) 48px);
    }

    /* =============================================
       NAV BAR
    ============================================= */
    .game-nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 14px 28px;
      background: var(--nav-bg);
      border-bottom: 1px solid var(--border);
      backdrop-filter: blur(14px);
      box-shadow: 0 2px 24px var(--glow-teal);
    }

    .nav-left, .nav-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .footer-brand {
      position: fixed;
      bottom: 18px;
      left: 50%;
      transform: translateX(-50%);
      font-family: 'Orbitron', monospace;
      font-size: 11px;
      font-weight: 500;
      color: var(--text-muted);
      letter-spacing: 0.25em;
      text-transform: uppercase;
      pointer-events: none;
      z-index: 10;
      white-space: nowrap;
    }

    /* Game Button */
    .game-btn {
      font-family: 'Orbitron', monospace;
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.06em;
      color: var(--text-1);
      background: var(--bg-panel);
      border: 1px solid var(--border);
      padding: 11px 22px;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      position: relative;
      overflow: hidden;
      clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
      transition: all 0.2s ease;
      white-space: nowrap;
    }

    .game-btn .btn-fill {
      position: absolute;
      inset: 0;
      background: #f7ffc7;
      opacity: 0;
      transition: opacity 0.2s ease;
    }

    .game-btn span { position: relative; z-index: 1; }

    .game-btn:hover { color: #081014ed; border-color: var(--accent); box-shadow: 0 0 14px var(--glow); }
    .game-btn:hover .btn-fill { opacity: 1; }

    /* Icon Button + Theme Toggle — shared nav icon style */
    .icon-btn,
    .theme-toggle {
      width: 46px; height: 46px;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
      transition: all 0.2s ease;
      flex-shrink: 0;
      color: var(--text-1);
    }

    .icon-btn:hover,
    .theme-toggle:hover { border-color: var(--accent); background: #f7ffc7; color: #081014ed; box-shadow: 0 0 12px var(--glow); }
    .icon-btn img { width: 26px; height: 26px; pointer-events: none; }

    .toggle-thumb {
      display: flex; align-items: center; justify-content: center;
      font-size: 20px;
      line-height: 1;
      background: transparent;
    }

    /* =============================================
       MAIN CONTENT
    ============================================= */
    .main-content {
      display: flex; align-items: center; justify-content: center;
      min-height: 100vh;
      padding: 90px 20px 48px;
      position: relative;
      z-index: 2;
    }

    .welcome-wrap { width: 100%; max-width: 560px; }

    .tx-tag {
      font-family: 'Orbitron', monospace;
      font-size: 10px; font-weight: 500;
      color: var(--accent);
      letter-spacing: 0.22em; text-transform: uppercase;
      margin-bottom: 14px;
      display: flex; align-items: center; gap: 10px;
      opacity: 0;
      animation: fadeUp 0.5s ease 0.2s forwards;
    }

    .tx-tag::before { content: ''; width: 28px; height: 1px; background: var(--accent); flex-shrink: 0; }
    .tx-tag::after  { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, var(--border), transparent); }

    .welcome-panel {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      padding: 40px 40px 36px;
      position: relative;
      box-shadow: 0 0 40px rgba(47,137,134,0.12), inset 0 0 30px rgba(146,211,79,0.03);
      opacity: 0;
      animation: fadeUp 0.6s ease 0.4s forwards;
    }

    /* Corner bracket decorations */
    .welcome-panel::before, .welcome-panel::after,
    .corner-tr, .corner-bl {
      content: '';
      position: absolute;
      width: 18px; height: 18px;
      border-color: var(--accent-hi);
      border-style: solid;
    }

    .welcome-panel::before { top: -1px;    left: -1px;  border-width: 2px 0 0 2px; }
    .welcome-panel::after  { bottom: -1px; right: -1px; border-width: 0 2px 2px 0; }
    .corner-tr             { top: -1px;    right: -1px; border-width: 2px 2px 0 0; }
    .corner-bl             { bottom: -1px; left: -1px;  border-width: 0 0 2px 2px; }

    .welcome-text { margin-bottom: 30px; }

    .salutation {
      font-family: 'Orbitron', monospace;
      font-size: 17px; font-weight: 700;
      color: var(--text-1);
      margin-bottom: 14px;
      text-shadow: 0 0 22px var(--glow);
    }

    .welcome-text p { font-size: 14.5px; line-height: 1.85; color: var(--text-2); }
    .ready-line { color: var(--accent-hi) !important; font-weight: 600; margin-top: 12px; }

    /* Form */
    .form-group { margin-bottom: 20px; }

    .form-label {
      font-family: 'Orbitron', monospace;
      font-size: 9.5px; font-weight: 600;
      letter-spacing: 0.18em; color: var(--text-muted);
      text-transform: uppercase;
      display: block; margin-bottom: 8px;
    }

    .game-input {
      width: 100%; padding: 11px 15px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-1);
      font-family: 'Exo 2', sans-serif; font-size: 14px;
      outline: none;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .game-input::placeholder { color: var(--text-muted); opacity: 0.7; }
    .game-input:focus {
      border-color: var(--accent);
      box-shadow: 0 0 14px var(--glow), inset 0 0 8px rgba(146,211,79,0.04);
    }

    /* ---- Custom Game Dropdown (reusable component) ---- */
    .game-dropdown {
      position: relative;
      width: 100%;
      user-select: none;
    }

    .gd-trigger {
      width: 100%;
      padding: 11px 42px 11px 15px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-1);
      font-family: 'Exo 2', sans-serif;
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      position: relative;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .game-dropdown:focus .gd-trigger,
    .game-dropdown.open  .gd-trigger {
      border-color: var(--accent);
      box-shadow: 0 0 14px var(--glow), inset 0 0 8px rgba(146,211,79,0.04);
      outline: none;
    }

    .gd-selected {
      flex: 1;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .gd-selected.placeholder { color: var(--text-muted); opacity: 0.7; }

    .gd-arrow {
      position: absolute;
      right: 14px; top: 50%;
      transform: translateY(-50%);
      transition: transform 0.2s ease;
      pointer-events: none;
    }

    .game-dropdown.open .gd-arrow { transform: translateY(-50%) rotate(180deg); }

    .gd-menu {
      position: absolute;
      top: calc(100% + 2px);
      left: 0; right: 0;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      z-index: 500;
      list-style: none;
      max-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: max-height 0.22s ease, opacity 0.15s ease;
      box-shadow: 0 8px 28px rgba(0,0,0,0.45), 0 0 18px var(--glow-teal);
    }

    .game-dropdown.open .gd-menu {
      max-height: 260px;
      overflow-y: auto;
      opacity: 1;
    }

    .gd-option {
      padding: 10px 16px;
      font-family: 'Exo 2', sans-serif;
      font-size: 14px;
      color: var(--text-1);
      cursor: pointer;
      border-left: 2px solid transparent;
      transition: background 0.12s, color 0.12s, border-color 0.12s;
    }

    .gd-option:hover,
    .gd-option.focused {
      background: rgba(47,137,134,0.18);
      border-left-color: var(--accent);
      color: var(--accent-hi);
    }

    .gd-option.sel {
      color: var(--accent);
      background: rgba(146,211,79,0.06);
    }

    .gd-menu::-webkit-scrollbar { width: 4px; }
    .gd-menu::-webkit-scrollbar-track { background: transparent; }
    .gd-menu::-webkit-scrollbar-thumb { background: var(--border); }

    /* CTA */
    .cta-row { margin-top: 28px; display: flex; justify-content: center; }

    .cta-btn {
      font-family: 'Orbitron', monospace;
      font-size: 12px; font-weight: 800;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: #071207;
      background: var(--accent);
      border: none; padding: 16px 44px; cursor: pointer;
      clip-path: polygon(18px 0%, 100% 0%, calc(100% - 18px) 100%, 0% 100%);
      transition: all 0.22s ease;
      display: flex; align-items: center; gap: 12px;
      box-shadow: 0 4px 24px var(--glow), 0 0 48px rgba(146,211,79,0.12);
    }

    .cta-btn:hover { background: #f7ffc7; box-shadow: 0 4px 36px var(--glow), 0 0 70px rgba(211,237,102,0.22); transform: translateY(-2px); }
    .cta-btn:active { transform: translateY(0); }
    [data-theme="light"] .cta-btn { background: #4bd311; }
    [data-theme="light"] .cta-btn:hover { background: #59f815; }
    [data-theme="light"] #saucer-cursor polygon { fill: #0d1f5c; }
    [data-theme="light"] #saucer-cursor polygon:first-of-type { fill: rgba(13,31,92,0.35); } /* glow bloom */

    /* =============================================
       MODALS
    ============================================= */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(0,0,0,0.76); backdrop-filter: blur(5px);
      z-index: 200;
      display: flex; align-items: center; justify-content: center;
      opacity: 0; pointer-events: none;
      transition: opacity 0.3s ease;
      padding: 16px;
    }

    .modal-overlay.open { opacity: 1; pointer-events: all; }

    .modal-panel {
      background: var(--bg-panel); border: 1px solid var(--border);
      position: relative;
      transform: translateY(18px); transition: transform 0.3s ease;
      max-height: 90vh;
      display: flex; flex-direction: column; overflow: hidden;
      box-shadow: 0 0 50px var(--glow-teal);
    }

    .modal-overlay.open .modal-panel { transform: translateY(0); }

    .modal-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 15px 22px;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }

    .modal-title {
      font-family: 'Orbitron', monospace;
      font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; color: var(--accent);
      text-transform: uppercase;
    }

    .modal-close {
      width: 28px; height: 28px;
      background: transparent; border: 1px solid var(--border);
      color: var(--text-2); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      font-size: 14px; font-family: monospace;
      transition: all 0.2s; flex-shrink: 0;
    }

    .modal-close:hover { border-color: var(--accent); color: var(--accent); box-shadow: 0 0 8px var(--glow); }

    /* =============================================
       WORLD MAP MODAL
    ============================================= */
    .worldmap-panel { width: min(92vw, 980px); }
    .worldmap-body { padding: 22px; overflow-y: auto; }

    .map-wrap {
      background: rgba(3,12,18,0.85);
      border: 1px solid rgba(47,137,134,0.28);
      padding: 12px; position: relative;
    }

    .map-wrap svg { width: 100%; height: auto; display: block; }
    .map-ocean { fill: rgba(6,18,28,0.9); }
    .continent {
      fill: rgba(47,137,134,0.22);
      stroke: #2F8986; stroke-width: 0.8;
      stroke-linejoin: round;
      transition: fill 0.2s;
    }
    .continent:hover { fill: rgba(47,137,134,0.42); }
    .grid-ln { stroke: rgba(47,137,134,0.10); stroke-width: 0.5; fill: none; }
    .equator { stroke: rgba(47,137,134,0.28); stroke-width: 0.7; stroke-dasharray: 5 5; fill: none; }

    .proj-marker { cursor: pointer; }
    .proj-marker:hover .m-ring { stroke: #D3ED66; }

    .m-pulse { fill: none; stroke: #92D34F; stroke-width: 1; animation: pulse 2.2s ease-out infinite; }
    .m-ring  { fill: none; stroke: #92D34F; stroke-width: 1.5; }
    .m-dot   { fill: #92D34F; }

    @keyframes pulse {
      0%  { r: 7;  opacity: 0.9; }
      60% { r: 14; opacity: 0.15; }
      100%{ r: 14; opacity: 0; }
    }

    .m-lbl { font-family: 'Orbitron', monospace; font-size: 6.5px; fill: #D3ED66; font-weight: 600; letter-spacing: 0.04em; pointer-events: none; }
    .m-sub { font-family: 'Exo 2', sans-serif; font-size: 6px; fill: #7db05a; pointer-events: none; }
    .m-line { stroke: rgba(146,211,79,0.4); stroke-width: 0.7; fill: none; stroke-dasharray: 2 2; }

    .map-legend { margin-top: 14px; display: flex; flex-wrap: wrap; gap: 10px 20px; }
    .legend-row { display: flex; align-items: center; gap: 7px; font-family: 'Exo 2', sans-serif; font-size: 12px; color: var(--text-2); }
    .legend-dot { width: 8px; height: 8px; background: var(--accent); border-radius: 50%; box-shadow: 0 0 6px var(--glow); flex-shrink: 0; }
    .legend-row a { color: var(--text-2); text-decoration: none; transition: color 0.2s; }
    .legend-row a:hover { color: var(--accent-hi); }

    /* =============================================
       SETTINGS MODAL
    ============================================= */
    .settings-panel { width: min(92vw, 440px); }
    .settings-body { padding: 24px; overflow-y: auto; }

    .marker-grid { display: flex; gap: 8px; flex-wrap: wrap; }
    .marker-opt {
      width: 46px; height: 46px;
      background: var(--bg-input); border: 2px solid var(--border);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      font-size: 20px; transition: all 0.2s;
    }
    .marker-opt:hover, .marker-opt.sel { border-color: var(--accent); box-shadow: 0 0 12px var(--glow); }

    .settings-save {
      width: 100%; font-family: 'Orbitron', monospace;
      font-size: 10px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: #071207; background: var(--accent);
      border: none; padding: 14px; cursor: pointer;
      clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
      transition: all 0.2s; margin-top: 6px;
    }
    .settings-save:hover { background: var(--accent-hi); }

    /* =============================================
       ANIMATIONS
    ============================================= */
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    @keyframes scanAnim {
      0%   { top: -4px; opacity: 0; }
      5%   { opacity: 1; }
      92%  { opacity: 0.7; }
      100% { top: 100vh; opacity: 0; }
    }

    .scan-line {
      position: fixed; left: 0; right: 0; height: 2px;
      background: linear-gradient(90deg, transparent 0%, var(--accent) 40%, var(--accent-hi) 50%, var(--accent) 60%, transparent 100%);
      animation: scanAnim 2.4s ease 0.1s forwards;
      pointer-events: none; z-index: 50;
      box-shadow: 0 0 8px var(--glow);
    }

    /* =============================================
       CUSTOM SAUCER CURSOR
    ============================================= */
    * { cursor: none !important; }

    #saucer-cursor {
      position: fixed;
      pointer-events: none;
      z-index: 9999;
      /* hotspot at nose tip: (2,2) in SVG coords */
      transform: translate(-2px, -2px);
      opacity: 0;
      transition: opacity 0.15s ease;
      will-change: transform;
    }

    #saucer-cursor.visible { opacity: 1; }

    /* Glow blooms: base + outer ring */
    #saucer-cursor .sg-glow {
      animation: saucer-glow 1.6s ease-in-out infinite;
    }
    #saucer-cursor .sg-beam {
      animation: beam-pulse 1.6s ease-in-out infinite;
    }

    @keyframes saucer-glow {
      0%,100% { opacity: 0.55; }
      50%      { opacity: 1.0; }
    }

    @keyframes beam-pulse {
      0%,100% { opacity: 0.55; }
      50%      { opacity: 1.0; }
    }

    #trail-canvas {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 9998;
    }

    .bg-ships {
      position: fixed; inset: 0;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .ship {
      position: absolute;
      top: 0; left: 0;
      will-change: transform;
      line-height: 0;
      transform-origin: 50% 50%;
    }

    .bg-ships .hull    { fill: rgba(47,137,134,0.55); }
    .bg-ships .pod     { fill: rgba(15,45,43,0.80); }
    .bg-ships .wing    { fill: rgba(65,183,116,0.50); }
    .bg-ships .nose    { fill: rgba(146,211,79,0.65); }
    .bg-ships .cockpit { fill: rgba(211,237,102,0.40); }
    .bg-ships .eg      { fill: rgba(146,211,79,0.55); animation: engine-pulse 1.8s ease-in-out infinite; }

    @keyframes engine-pulse {
      0%, 100% { opacity: 0.55; }
      50%       { opacity: 1; }
    }

    /* Stagger engine pulse so ships don't blink in sync */
    .s2 .eg { animation-delay: -0.6s; }
    .s3 .eg { animation-delay: -1.1s; }
    .s4 .eg { animation-delay: -0.3s; }
    .s5 .eg { animation-delay: -1.5s; }
    .s6 .eg { animation-delay: -0.9s; }
    .s7 .eg { animation-delay: -0.4s; }

    @media (max-width: 640px) {
      .game-btn { font-size: 9px; padding: 7px 12px; }
      .footer-brand { display: none; }
      .welcome-panel { padding: 28px 22px 26px; }
    }
  </style>
</head>

<body>
  <div class="scan-line" aria-hidden="true"></div>

  <!-- CUSTOM TRIANGLE CURSOR -->
  <!-- Tip (hotspot) = SVG (2, 2) → CSS transform: translate(-2px, -2px) -->
  <svg id="saucer-cursor" xmlns="http://www.w3.org/2000/svg"
       width="28" height="30" viewBox="0 0 28 30"
       aria-hidden="true">
    <defs>
      <filter id="cursor-glow" x="-80%" y="-80%" width="260%" height="260%">
        <feGaussianBlur stdDeviation="3.5" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>
    <!-- Outer glow bloom -->
    <polygon points="2,2 2,26 22,18"
             fill="rgba(255,204,0,0.35)"
             filter="url(#cursor-glow)"/>
    <!-- Solid yellow triangle -->
    <polygon points="2,2 2,26 22,18"
             fill="#ffcc00"/>
  </svg>

  <canvas id="trail-canvas" aria-hidden="true"></canvas>

  <!-- BACKGROUND SPACESHIPS -->
  <div class="bg-ships" aria-hidden="true">

    <!-- s1: Scout · LTR · 60×36 -->
    <div class="ship s1">
