    <div class="modal-panel settings-panel">
      <div class="modal-header">
        <span class="modal-title" id="settingsTitle">// EXPLORER SETTINGS</span>
        <button class="modal-close" id="closeSettings" aria-label="Close settings">&#10005;</button>
      </div>
      <div class="settings-body">
        <div class="form-group">
          <label class="form-label" for="settingsNickname">Explorer nickname</label>
          <input type="text" id="settingsNickname" class="game-input" placeholder="Your nickname" maxlength="24" autocomplete="off" />
        </div>
        <div class="form-group">
          <label class="form-label">Location marker</label>
          <div class="marker-grid" id="markerGrid">
            <button class="marker-opt sel" type="button" data-marker="pin">&#128205;</button>
            <button class="marker-opt"     type="button" data-marker="star">&#11088;</button>
            <button class="marker-opt"     type="button" data-marker="rocket">&#128640;</button>
            <button class="marker-opt"     type="button" data-marker="target">&#127919;</button>
            <button class="marker-opt"     type="button" data-marker="crystal">&#128302;</button>
            <button class="marker-opt"     type="button" data-marker="bolt">&#9889;</button>
            <button class="marker-opt"     type="button" data-marker="glow">&#127775;</button>
            <button class="marker-opt"     type="button" data-marker="compass">&#129517;</button>
          </div>
        </div>
        <button class="settings-save" id="saveSettings" type="button">SAVE CHANGES</button>
      </div>
    </div>
  </div>

  <script>
    // Theme
    const html      = document.documentElement;
    const themeIcon = document.getElementById('themeIcon');

    function applyTheme(t) {
      html.setAttribute('data-theme', t);
      themeIcon.textContent = t === 'dark' ? '\u{1F319}' : '\u2600\uFE0F';
      try { localStorage.setItem('ex-theme', t); } catch (_) {}
    }

    try { applyTheme(localStorage.getItem('ex-theme') || 'dark'); } catch(_) { applyTheme('dark'); }
    document.getElementById('btnTheme').addEventListener('click', () => {
      applyTheme(html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
    });

    // Modal helpers
    function openModal(id)  { document.getElementById(id).classList.add('open'); }
    function closeModal(id) { document.getElementById(id).classList.remove('open'); }

    function bindClose(modalId, closeBtnId) {
      const overlay = document.getElementById(modalId);
      document.getElementById(closeBtnId).addEventListener('click', () => closeModal(modalId));
      overlay.addEventListener('click', e => { if (e.target === overlay) closeModal(modalId); });
      overlay.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(modalId); });
    }

    // World Map
    document.getElementById('btnWorldMap').addEventListener('click', () => openModal('worldMapModal'));
    bindClose('worldMapModal', 'closeWorldMap');

    const markerNav = {
      'mArkeamerica': '/projects/e-america',
      'm-eamerica':   '/projects/e-america',
      'm-mb':         '/projects/mbfs-sea',
      'm-sg':         '/projects/verity-nature',
      'm-vn':         '/projects/boulder-box-saigon',
      'm-au':         '/projects/mbfs-au',
    };

    document.querySelectorAll('.proj-marker').forEach(el => {
      const go = () => { const h = markerNav[el.id]; if (h) window.location.href = h; };
      el.addEventListener('click', go);
      el.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') go(); });
    });

    // Settings
    document.getElementById('btnSettings').addEventListener('click', () => {
      try {
        document.getElementById('settingsNickname').value = localStorage.getItem('ex-nickname') || '';
        const saved = localStorage.getItem('ex-marker') || 'pin';
        document.querySelectorAll('.marker-opt').forEach(b => b.classList.toggle('sel', b.dataset.marker === saved));
      } catch(_) {}
      openModal('settingsModal');
    });

    bindClose('settingsModal', 'closeSettings');

    document.getElementById('markerGrid').addEventListener('click', e => {
      const btn = e.target.closest('.marker-opt');
      if (!btn) return;
      document.querySelectorAll('.marker-opt').forEach(b => b.classList.remove('sel'));
      btn.classList.add('sel');
    });

    document.getElementById('saveSettings').addEventListener('click', () => {
      const nick   = document.getElementById('settingsNickname').value.trim();
      const marker = document.querySelector('.marker-opt.sel')?.dataset.marker || 'pin';
      try {
        if (nick) { localStorage.setItem('ex-nickname', nick); document.getElementById('nickname').value = nick; }
        localStorage.setItem('ex-marker', marker);
      } catch(_) {}
      closeModal('settingsModal');
    });

    // Explorer Form
    try { const s = localStorage.getItem('ex-nickname'); if (s) document.getElementById('nickname').value = s; } catch(_) {}

    document.getElementById('explorerForm').addEventListener('submit', e => {
      e.preventDefault();
      const nick   = document.getElementById('nickname').value.trim();
      const server = document.getElementById('server').value;

      function shake(id) {
        const el     = document.getElementById(id);
        const visual = el.classList.contains('game-dropdown') ? el.querySelector('.gd-trigger') : el;
        el.focus();
        visual.style.borderColor = '#ff6b6b';
        visual.style.boxShadow   = '0 0 12px rgba(255,107,107,0.4)';
        setTimeout(() => { visual.style.borderColor = ''; visual.style.boxShadow = ''; }, 1800);
      }

      if (!nick)   { shake('nickname');       return; }
      if (!server) { shake('serverDropdown'); return; }

      try { localStorage.setItem('ex-nickname', nick); localStorage.setItem('ex-server', server); } catch(_) {}
      openModal('worldMapModal');
    });

    // Custom server dropdown controller
    (function () {
      const dd      = document.getElementById('serverDropdown');
      const display = document.getElementById('serverDisplay');
      const menu    = document.getElementById('serverMenu');
      const hidden  = document.getElementById('server');
      const opts    = Array.from(menu.querySelectorAll('.gd-option'));
      let focusIdx  = -1;

      function open() {
        dd.classList.add('open');
        dd.setAttribute('aria-expanded', 'true');
      }
      function close() {
        dd.classList.remove('open');
        dd.setAttribute('aria-expanded', 'false');
        opts.forEach(o => o.classList.remove('focused'));
        focusIdx = -1;
      }
      function select(opt) {
        opts.forEach(o => o.classList.remove('sel'));
        opt.classList.add('sel');
        display.textContent = opt.textContent;
        display.classList.remove('placeholder');
        hidden.value = opt.dataset.value;
        close();
      }
      function moveFocus(idx) {
        opts.forEach(o => o.classList.remove('focused'));
        focusIdx = Math.max(0, Math.min(idx, opts.length - 1));
        opts[focusIdx].classList.add('focused');
        opts[focusIdx].scrollIntoView({ block: 'nearest' });
      }

      dd.addEventListener('click', e => {
        const opt = e.target.closest('.gd-option');
        if (opt) { select(opt); return; }
        dd.classList.contains('open') ? close() : open();
      });

      dd.addEventListener('keydown', e => {
        if (!dd.classList.contains('open')) {
          if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
            e.preventDefault(); open(); moveFocus(0);
          }
          return;
        }
        if (e.key === 'Escape')    { e.preventDefault(); close(); }
        if (e.key === 'ArrowDown') { e.preventDefault(); moveFocus(focusIdx + 1); }
        if (e.key === 'ArrowUp')   { e.preventDefault(); moveFocus(focusIdx - 1); }
        if (e.key === 'Enter' && focusIdx >= 0) { e.preventDefault(); select(opts[focusIdx]); }
      });

      document.addEventListener('click', e => { if (!dd.contains(e.target)) close(); });
    })();

    // Background ship controller — random angles, sinusoidal drift, rotation
    (function () {
      const ships = Array.from(document.querySelectorAll('.bg-ships .ship'));

      // Per-ship config: [angleDeg, speedPx/frame, driftAmp, driftFreq, opacity]
      const cfg = [
        [ 18,  0.55, 28, 0.0070, 0.50],  // s1 scout      shallow right-down
        [200,  0.68, 18, 0.0110, 0.40],  // s2 scout      left-down
        [345,  0.28, 52, 0.0048, 0.42],  // s3 cruiser     shallow right-up
        [130,  0.50, 22, 0.0090, 0.38],  // s4 saucer      right-down steep
        [ 55,  0.72, 14, 0.0130, 0.33],  // s5 tiny scout  diagonal up-right
        [240,  0.32, 42, 0.0055, 0.28],  // s6 cruiser     left-up
        [165,  0.44, 30, 0.0080, 0.30],  // s7 saucer      nearly left
      ];

      const state = ships.map((el, i) => {
        const [angleDeg, speed, dAmp, dFreq, opacity] = cfg[i] || cfg[0];
        const angle = angleDeg * Math.PI / 180;
        const w = el.offsetWidth  || 60;
        const h = el.offsetHeight || 36;
        return {
          el, w, h, angle, speed,
          x: Math.random() * window.innerWidth,
          y: Math.random() * window.innerHeight,
          drift: { amp: dAmp, freq: dFreq },
          driftPhase: Math.random() * Math.PI * 2,
          opacity,
          t: Math.random() * 600,
        };
      });

      // Apply opacity once
      state.forEach(s => { s.el.style.opacity = s.opacity; });

      function tick() {
        const W = window.innerWidth;
        const H = window.innerHeight;
        const margin = 160;

        for (const s of state) {
          s.t++;
          s.x += Math.cos(s.angle) * s.speed;
          s.y += Math.sin(s.angle) * s.speed;

          // Sinusoidal drift perpendicular to heading
          const perpX = -Math.sin(s.angle);
          const perpY =  Math.cos(s.angle);
          const d  = Math.sin(s.t * s.drift.freq + s.driftPhase) * s.drift.amp;
          const rx = s.x + perpX * d;
          const ry = s.y + perpY * d;

          // Wrap around all four edges
          if (s.x < -margin)      s.x = W + margin;
          else if (s.x > W + margin) s.x = -margin;
          if (s.y < -margin)      s.y = H + margin;
          else if (s.y > H + margin) s.y = -margin;

          // Place center at (rx, ry) and rotate ship to face its heading
          const deg = s.angle * 180 / Math.PI;
          s.el.style.transform =
            `translate(${rx - s.w * 0.5}px, ${ry - s.h * 0.5}px) rotate(${deg}deg)`;
        }
        requestAnimationFrame(tick);
      }
      tick();
    })();

    // Saucer cursor + gas trail
    (function () {
      const cur    = document.getElementById('saucer-cursor');
      const canvas = document.getElementById('trail-canvas');
      const ctx    = canvas.getContext('2d');

      function resize() {
        canvas.width  = window.innerWidth;
        canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      // Cursor position tracking
      let cx = -500, cy = -500;  // current
      let px = -500, py = -500;  // previous (for velocity)
      let curRaf = null;

      // Particle pool
      const particles = [];

      document.addEventListener('mousemove', e => {
        px = cx; py = cy;
        cx = e.clientX; cy = e.clientY;

        // Move saucer
        if (!curRaf) curRaf = requestAnimationFrame(() => {
          curRaf = null;
          cur.style.left = cx + 'px';
          cur.style.top  = cy + 'px';
        });

        // Spawn trail particles from base of triangle (bottom-right corner ~SVG 22,18 and 2,26)
        // Average base midpoint SVG ~(12,22); hotspot offset (-2,-2) → screen offset = (+10, +20)
        const ox = cx + 10;
        const oy = cy + 20;
        const dx = cx - px;
        const dy = cy - py;
        const speed = Math.sqrt(dx * dx + dy * dy);
        const count = Math.min(2 + Math.floor(speed * 0.25), 7);

        for (let i = 0; i < count; i++) {
          const spread = (Math.random() - 0.5) * 6;
          // Trail velocity: opposite to movement direction + spread
          const invSpeed = speed > 0.5 ? 1 / speed : 0;
          const tvx = speed > 0.5
            ? (-dx * invSpeed) * (0.6 + Math.random() * 1.2) + (Math.random() - 0.5) * 1.2
            : (Math.random() - 0.5) * 1.4;
          const tvy = speed > 0.5
            ? (-dy * invSpeed) * (0.6 + Math.random() * 1.2) + Math.random() * 1.0
            : Math.random() * 1.2 + 0.4;

          particles.push({
            x:     ox + spread,
            y:     oy,
            vx:    tvx,
            vy:    tvy,
            life:  1.0,
            decay: 0.022 + Math.random() * 0.030,
            size:  2.5 + Math.random() * 3.5,
            hue:   40 + Math.random() * 25,   // yellow → amber
            sat:   85 + Math.random() * 15,
          });
        }
      });

      document.addEventListener('mouseenter', () => cur.classList.add('visible'));
      document.addEventListener('mouseleave', () => cur.classList.remove('visible'));
      document.addEventListener('mousemove',  () => cur.classList.add('visible'), { once: true });

      // Render loop
      function loop() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x    += p.vx;
          p.y    += p.vy;
          p.vy   += 0.06;          // gravity drip
          p.life -= p.decay;
          p.size *= 0.968;

          if (p.life <= 0 || p.size < 0.4) { particles.splice(i, 1); continue; }

          const r   = p.size * 2.8;
          const grd = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, r);
          const isLight = document.documentElement.dataset.theme === 'light';
          if (isLight) {
            grd.addColorStop(0,   `hsla(225,70%,22%,${p.life * 0.05})`);
            grd.addColorStop(0.35,`hsla(225,70%,22%,${p.life * 0.02})`);
            grd.addColorStop(1,   `hsla(225,70%,22%,0)`);
          } else {
            grd.addColorStop(0,   `hsla(${p.hue},${p.sat}%,78%,${p.life * 0.14})`);
            grd.addColorStop(0.35,`hsla(${p.hue},${p.sat}%,62%,${p.life * 0.06})`);
            grd.addColorStop(1,   `hsla(${p.hue},${p.sat}%,50%,0)`);
          }

          ctx.beginPath();
          ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
          ctx.fillStyle = grd;
          ctx.fill();
        }

        requestAnimationFrame(loop);
      }
      loop();
    })();
  </script>
  <div class="footer-brand" aria-hidden="true">EXPLORER MODE v1.0</div>
</body>
</html>
