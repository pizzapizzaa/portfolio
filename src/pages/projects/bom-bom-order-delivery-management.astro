---
import MissionLayout from '../../layouts/MissionLayout.astro';
---

<MissionLayout
  slug="bom-bom-order-delivery-management"
  heading="BOM BOM Order & Delivery Management"
  status="Product redesign"
  explorerGradient="linear-gradient(40deg, #210913 0%, #57152c 100%)"
>
  <section class="case-section">
    <h2 class="case-section-title">1. The Brief</h2>
    <div class="case-field">
      <h3 class="case-field-label">The Purpose</h3>
      <p class="case-field-value">Revamp BOM BOM’s fresh pet-food order and delivery management system for the Singapore market.</p>
    </div>
    <div class="case-field">
      <h3 class="case-field-label">The Context</h3>
      <p class="case-field-value">The existing delivery system had been in use for roughly 10 years. It had become clunky and lacked the intelligence needed to support the service effectively.</p>
    </div>
    <div class="case-field">
      <h3 class="case-field-label">The Challenge</h3>
      <p class="case-field-value">Replace an aging system with a more considered experience for managing fresh-food orders and deliveries in Singapore.</p>
    </div>
  </section>

  <section class="case-section">
    <h2 class="case-section-title">2. Role &amp; Focus</h2>
    <div class="case-field">
      <h3 class="case-field-label">Role</h3>
      <p class="case-field-value">Design Lead.</p>
    </div>
    <div class="case-field">
      <h3 class="case-field-label">Project Focus</h3>
      <p class="case-field-value">The redesign focuses on the order and delivery management system behind BOM BOM’s fresh pet-food service. Further workflow details and outcome metrics are not included here.</p>
    </div>
  </section>

  <section class="case-section">
    <h2 class="case-section-title">3. Order Flow Redesign</h2>
    <div class="case-field">
      <h3 class="case-field-label">Design Sequence</h3>
      <p class="case-field-value">From the current order experience and references through the flow charts, homepage, onboarding, pet details, recommendations, and plan building.</p>
      <div class="gallery-wrap" role="region" aria-label="BOM BOM order flow design screens">
        <div class="gallery-track-wrap">
          <div class="gallery-track">
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/00_order-screenshot-1.png" alt="00 — Existing BOM BOM order experience" loading="lazy" decoding="async" />
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/01_references.png" alt="01 — Order flow design references" loading="lazy" decoding="async" />
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/01A_flow-charts.png" alt="01A — Order flow charts" loading="lazy" decoding="async" />
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/02_Homepage_D_v1.0.png" alt="02 — BOM BOM order homepage design" loading="lazy" decoding="async" />
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/03_Order_Onboarding_D_v1.0.png" alt="03 — Order onboarding design" loading="lazy" decoding="async" />
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/04_Order_Basic%20info_D_v1.0.png" alt="04 — Order basic information design" loading="lazy" decoding="async" />
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/05-Desktop-Quick-recommendation%201.png" alt="05 — Desktop quick recommendation design" loading="lazy" decoding="async" />
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/06-Desktop-Build-the-plan%203.png" alt="06 — Desktop build-the-plan design" loading="lazy" decoding="async" />
            <img class="gallery-img" src="/assets/projects/BOMBOM_order/Mock-up.png" alt="BOM BOM order flow mock-up" loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="gallery-controls">
          <button class="gallery-btn" type="button" aria-label="Previous image">&#8592; Back</button>
          <span class="gallery-counter" aria-live="polite">1 / 9</span>
          <button class="gallery-btn" type="button" aria-label="Next image">Next &#8594;</button>
        </div>
      </div>
    </div>
  </section>
</MissionLayout>
