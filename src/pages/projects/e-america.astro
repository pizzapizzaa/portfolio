---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="e-America - Case Study">
  <Header basePath="/" />
  
  <main class="pt-24">
    <section class="min-h-screen flex items-center justify-center px-4 py-30">
      <div class="max-w-4xl w-full relative z-10">
        <h1 class="text-[80px] md:text-[120px] leading-none font-heading font-bold text-white mb-8">e-America</h1>
        <p class="text-[20px] leading-relaxed" style="color: rgb(255, 184, 0);">
          Case study will be updated soon...
        </p>
      </div>
    </section>
  </main>
</Layout>
