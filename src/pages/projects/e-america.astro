---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
---

<Layout title="e-America Platform - Case Study">
  <Header basePath="/" />

  <main class="pt-24" style="background: linear-gradient(40deg, #122249 0%, #542045 100%)">

    <!-- Hero -->
    <section class="relative min-h-screen flex items-center py-24" style="background-image: url('/assets/projects/e-america/e-america-background.png'); background-size: cover; background-position: center;">
      <div class="absolute inset-0" style="background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.85));"></div>
      <div class="relative z-10" style="max-width: 860px; margin-left: auto; margin-right: auto; width: 100%; padding-left: 24px; padding-right: 24px;">
        <h1 class="text-[64px] md:text-[100px] leading-none font-heading font-bold text-white mb-6">e-America Platform</h1>
        <div class="flex flex-wrap gap-3 text-[15px]" style="color: rgb(255,184,0);">
          <span>Role: Lead Product Designer</span>
          <span style="opacity:0.4;">|</span>
          <span>Timeline: 2 Months</span>
          <span style="opacity:0.4;">|</span>
          <span>Status: <a href="https://e-america.org/" target="_blank" rel="noopener" style="color: inherit; text-decoration: underline; text-underline-offset: 3px;">Live</a></span>
        </div>
      </div>
      <div class="scroll-cue">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 256 256"><path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z" fill="currentColor"/></svg>
      </div>
    </section>

    <!-- Case Study Body -->
    <div class="case-study-body reveal-hidden">

      <section class="case-section">
        <h2 class="case-section-title">1. The TL;DR <span class="case-section-sub">(Executive Summary)</span></h2>
        <div class="case-field">
          <h3 class="case-field-label">The Purpose</h3>
          <p class="case-field-value">Building a digital parallel America that is open to all, voluntary by design, and global in spirit.</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">The Stakeholders</h3>
          <p class="case-field-value">Vikram, Founder. Adam, CTO</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">The Problem</h3>
          <p class="case-field-value">Vikram (from Draper Start-up House) wanted to build a platform that bridges the gap between a decentralized digital infrastructure and real-world human connection. The challenge was creating a brand that felt authentically human while maintaining the fluidity of a global digital platform.</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">The Solution</h3>
          <p class="case-field-value">A simplified, high-recall brand identity and a minimalist landing page/dashboard system designed for rapid global adoption.</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">The Impact</h3>
          <p class="case-field-value">Thousands of sign-ups since launch, with weekly physical events successfully kicking off in Singapore, Africa, America, and India.</p>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section-title">2. Strategy &amp; Discovery</h2>
        <div class="case-field">
          <h3 class="case-field-label">Insight</h3>
          <p class="case-field-value">We realized that e-Citizenship required a foundational system of civic motivators. By leveraging Vikram&rsquo;s previous startup data, we focused on building a sense of belonging rather than just another social feed.</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">Stakeholders</h3>
          <p class="case-field-value">I acted as the lead designer &amp; also the conduit between Vikram and Adam (our CTO), utilizing a day to day rapid UI design process to ensure vision and technical feasibility remained perfectly aligned.</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">Constraint</h3>
          <p class="case-field-value">Extreme time pressure. I delivered the full branding in 2 days, the landing page in 2 days, and the e-citizen dashboard in 4 days.</p>
        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section-title">3. Execution <span class="case-section-sub">(The &ldquo;How&rdquo;)</span></h2>
        <div class="case-field">
          <h3 class="case-field-label">Key Decision</h3>
          <p class="case-field-value">We chose a minimalist UI structure over a more complex social layout. This balanced Vikram&rsquo;s desire for social elements with the CTO&rsquo;s requirement for a seamless, scalable build under a tight deadline.</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">Design Leadership</h3>
          <p class="case-field-value">Despite the speed, I built a foundational UI kit, full icon library, logo kit, and social templates to ensure design consistency as the platform scales globally.</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">Visual Highlights</h3>
          <!-- Gallery -->
          <div class="gallery-wrap">
            <div class="gallery-track-wrap">
              <div class="gallery-track" id="galleryTrack">
                <img class="gallery-img" src="/assets/projects/e-america/playground.png" alt="Playground screen" />
                <img class="gallery-img" src="/assets/projects/e-america/Homepage_new.png" alt="Homepage screen" />
                <img class="gallery-img" src="/assets/projects/e-america/Events.png" alt="Events screen" />
              </div>
            </div>
            <div class="gallery-controls">
              <button class="gallery-btn" id="galleryPrev" aria-label="Previous">&#8592; Back</button>
              <span class="gallery-counter" id="galleryCounter">1 / 3</span>
              <button class="gallery-btn" id="galleryNext" aria-label="Next">Next &#8594;</button>
            </div>
          </div>

        </div>
      </section>

      <section class="case-section">
        <h2 class="case-section-title">4. Outcome &amp; Lessons</h2>
        <div class="case-field">
          <h3 class="case-field-label">KPIs</h3>
          <p class="case-field-value">Successfully hit the Live milestone in 8 weeks with a high-conversion landing page and a functional global dashboard.</p>
        </div>
        <div class="case-field">
          <h3 class="case-field-label">Next Steps</h3>
          <p class="case-field-value">Vikram and team are currently aggregating user insights from the global community to build out the Phase 2 feature roadmap.</p>
        </div>
      </section>

    </div>
  </main>
</Layout>

<style>
  .case-study-body { max-width: 860px; margin: 0 auto; padding: 64px 24px 96px; color: #fff; }
  .case-section { margin-bottom: 64px; border-top: 1px solid rgba(255,255,255,0.08); padding-top: 48px; }
  .case-section-title { font-size: 26px; font-weight: 700; color: rgb(255,184,0); margin-bottom: 36px; }
  .case-section-sub { font-size: 18px; font-weight: 400; color: rgba(255,184,0,0.6); }
  .case-field { margin-bottom: 32px; }
  .case-field-label { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.4); margin-bottom: 8px; }
  .case-field-value { font-size: 17px; line-height: 1.75; color: #fafafa; }
  .visual-placeholder { margin-top: 20px; border: 1px dashed rgba(255,184,0,0.25); border-radius: 12px; padding: 56px 24px; text-align: center; color: rgba(255,184,0,0.35); font-size: 15px; letter-spacing: 0.06em; }
  .reveal-hidden { opacity: 0; transform: translateY(40px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .reveal-visible { opacity: 1; transform: translateY(0); }
  .scroll-cue { position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%); color: rgba(255,184,0,0.55); animation: cue-bounce 2s ease-in-out infinite; pointer-events: none; }
  @keyframes cue-bounce { 0%, 100% { transform: translateX(-50%) translateY(0); } 50% { transform: translateX(-50%) translateY(10px); } }

  /* Gallery */
  .gallery-wrap { margin-top: 20px; }
  .gallery-track-wrap { overflow: hidden; border-radius: 12px; background: rgba(0,0,0,0.25); }
  .gallery-track { display: flex; transition: transform 0.4s ease; }
  .gallery-img { flex: 0 0 100%; width: 100%; max-height: 480px; object-fit: contain; cursor: pointer; display: block; }
  .gallery-controls { display: flex; align-items: center; justify-content: space-between; margin-top: 14px; }
  .gallery-btn { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15); color: #fafafa; padding: 8px 20px; border-radius: 8px; font-size: 14px; cursor: pointer; transition: background 0.2s; }
  .gallery-btn:hover { background: rgba(255,255,255,0.16); }
  .gallery-counter { font-size: 13px; color: rgba(255,255,255,0.45); letter-spacing: 0.08em; }


</style>

<script>
  // Scroll reveal
  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('reveal-visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.08 });
  document.querySelectorAll('.reveal-hidden').forEach(el => observer.observe(el));

  // Gallery
  const imgs = document.querySelectorAll<HTMLImageElement>('.gallery-img');
  const track = document.getElementById('galleryTrack') as HTMLElement;
  const counter = document.getElementById('galleryCounter') as HTMLElement;
  let current = 0;
  const total = imgs.length;

  function goTo(index: number) {
    current = (index + total) % total;
    (track as HTMLElement).style.transform = `translateX(-${current * 100}%)`;
    counter.textContent = `${current + 1} / ${total}`;
  }

  document.getElementById('galleryPrev')?.addEventListener('click', () => goTo(current - 1));
  document.getElementById('galleryNext')?.addEventListener('click', () => goTo(current + 1));

  imgs.forEach(img => {
    img.addEventListener('click', () => window.open(img.src, '_blank'));
  });
</script>
