const hintBtn      = document.getElementById('bboHintBtn')!;
const hintText     = document.getElementById('bboHintText') as HTMLElement;
const prevBtn      = document.getElementById('bboPrev') as HTMLButtonElement;
const nextBtn      = document.getElementById('bboNext') as HTMLButtonElement;
const storyType    = document.getElementById('bboStoryType')!;
