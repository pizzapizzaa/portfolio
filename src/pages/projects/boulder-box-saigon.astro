<script>
import { supabase, calcLevel, expProgress, rankTitle } from '../../lib/supabase';

// ── Helpers ───────────────────────────────────────────────────────
async function hashAnswer(answer: string): Promise<string> {
  const enc = new TextEncoder();
  const buf = await crypto.subtle.digest('SHA-256', enc.encode(answer.toLowerCase().trim()));
  return [...new Uint8Array(buf)].map(b => b.toString(16).padStart(2, '0')).join('');
}

const LETTERS = ['A', 'B', 'C', 'D', 'E', 'F'];

// ── State ─────────────────────────────────────────────────────────
interface QuizNode {
  id: string;
  node_type: string;
  title: string;
  prompt: string;
  options: string[] | null;
  hint: string | null;
  exp_reward: number;
  completed: boolean;
  attempts: number;
}

let nodes: QuizNode[] = [];      // quiz-type only (shown in dock)
let shareNode: QuizNode | null = null; // puzzle-type share bonus
let current = 0;
let nickname = '';
let dockOpen = false;

// ── Element refs ──────────────────────────────────────────────────
const hud          = document.getElementById('bbo-explorer-hud') as HTMLElement;
const dock         = document.getElementById('bbo-quiz-dock') as HTMLElement;
