const shareTwitter  = document.getElementById('bboShareTwitter') as HTMLButtonElement;
const shareCopy     = document.getElementById('bboShareCopy') as HTMLButtonElement;
const shareClaimed  = document.getElementById('bboShareClaimed') as HTMLElement;

// ── Update HUD display ────────────────────────────────────────────
function updateHudDisplay(exp: number, level: number, nick: string) {
  const base = (level - 1) * 100;
  const progress = expProgress(exp);
  hudRank.textContent = `LVL ${level} · ${rankTitle(level)}`;
  hudNick.textContent = nick;
  hudExpFill.style.width = `${Math.round(progress * 100)}%`;
  hudExpText.textContent = `${exp - base} / 100 EXP`;
}

function updateProgressBadge() {
  const done = nodes.filter(n => n.completed).length;
  hudProgress.textContent = `${done} / ${nodes.length} QUESTS`;
  hudProgress.style.color = done === nodes.length ? 'var(--bbo-accent)' : 'var(--bbo-gold)';
}

// ── Render progress dots ──────────────────────────────────────────
function renderDots() {
  dotsEl.innerHTML = '';
  nodes.forEach((n, i) => {
    const dot = document.createElement('button');
    dot.className = `bbo-dot${i === current ? ' active' : ''}${n.completed ? ' done' : ''}`;
    dot.title = n.title;
    dot.setAttribute('aria-label', `Question ${i + 1}: ${n.title}`);
    dot.addEventListener('click', () => { current = i; renderQuestion(); });
    dotsEl.appendChild(dot);
  });
}

// ── Render current question ───────────────────────────────────────
function renderQuestion() {
  renderDots();
  const node = nodes[current];
  if (!node) return;

  const allDone = nodes.every(n => n.completed);
  if (allDone) {
    cardEl.hidden = true;
    doneEl.hidden = false;
    const total = nodes.reduce((s, n) => s + n.exp_reward, 0);
    doneSub.textContent = `+${total} EXP earned across all quests.`;
    // Show share bonus banner if share not yet claimed
    if (shareNode && !shareNode.completed) {
      shareBanner.hidden = false;
    }
    return;
  }

  cardEl.hidden = false;
  doneEl.hidden = true;

  quizNum.textContent    = `${current + 1} / ${nodes.length}`;
  quizTitle.textContent  = node.title;
  quizExp.textContent    = `+${node.exp_reward} EXP`;
  quizPrompt.textContent = node.prompt;
  hintText.hidden        = true;
  hintText.textContent   = node.hint ?? '';

  prevBtn.disabled = current === 0;
  nextBtn.disabled = current === nodes.length - 1;

  // Options
  quizOptions.innerHTML = '';
  (node.options || []).forEach((opt: string, i: number) => {
    const btn = document.createElement('button');
    btn.className = `bbo-opt-btn${node.completed ? ' completed' : ''}`;
    btn.disabled = node.completed;
    btn.innerHTML = `<span class="bbo-opt-letter">${LETTERS[i]}.</span><span>${opt}</span>`;
    btn.addEventListener('click', () => handleAnswer(node, opt, btn));
    quizOptions.appendChild(btn);
  });
}

// ── Handle answer submission ──────────────────────────────────────
async function handleAnswer(node: QuizNode, selectedOpt: string, btn: HTMLButtonElement) {
  if (node.completed || !nickname || !supabase) return;

  // Disable all options immediately
  quizOptions.querySelectorAll<HTMLButtonElement>('.bbo-opt-btn').forEach(b => b.disabled = true);

  const h = await hashAnswer(selectedOpt);
  const { data, error } = await supabase.rpc('submit_answer', {
    p_nickname:    nickname,
    p_node_id:     node.id,
    p_answer_hash: h,
  });

  if (error || !data?.ok) {
    btn.classList.add('wrong');
    quizOptions.querySelectorAll<HTMLButtonElement>('.bbo-opt-btn').forEach(b => b.disabled = false);
    return;
  }

  if (data.correct) {
    node.completed = true;
    btn.classList.add('correct');

    // Update HUD EXP
    if (data.new_exp !== undefined) {
      updateHudDisplay(data.new_exp, data.new_level, nickname);
      // Persist updated profile in localStorage
      try {
        const cached = localStorage.getItem('ex-profile');
        if (cached) {
          const p = JSON.parse(cached);
          p.exp   = data.new_exp;
          p.level = data.new_level;
          localStorage.setItem('ex-profile', JSON.stringify(p));
        }
      } catch (_) {}
    }

    updateProgressBadge();
    renderDots();

    // Show story popup if a fragment was unlocked
    if (data.story_fragment) {
      const sf = data.story_fragment;
      showStory(sf.title, sf.body, sf.type, node.exp_reward);
    } else {
      // Auto-advance to next unanswered question
      const nextIdx = nodes.findIndex((n, i) => i > current && !n.completed);
      if (nextIdx !== -1) {
        setTimeout(() => { current = nextIdx; renderQuestion(); }, 800);
      } else {
        setTimeout(() => renderQuestion(), 800);
      }
    }
  } else {
    // Wrong — re-enable only the options that weren't selected
    btn.classList.add('wrong');
    setTimeout(() => {
      btn.classList.remove('wrong');
      quizOptions.querySelectorAll<HTMLButtonElement>('.bbo-opt-btn').forEach(b => b.disabled = false);
    }, 1000);
  }
}

// ── Story popup ───────────────────────────────────────────────────
function showStory(title: string, body: string, type: string, exp: number) {
  storyType.textContent  = type.toUpperCase();
  storyTitle.textContent = title;
  storyBody.textContent  = body.replace(/\{\{nickname\}\}/g, nickname);
  storyExp.textContent   = `+${exp} EXP`;
  storyPopup.hidden = false;
  storyPopup.removeAttribute('hidden');
  document.body.style.overflow = 'hidden';
}

storyClose.addEventListener('click', () => {
  storyPopup.hidden = true;
  document.body.style.overflow = '';
  // Auto-advance to next unanswered question
  const nextIdx = nodes.findIndex((n, i) => i > current && !n.completed);
  if (nextIdx !== -1) { current = nextIdx; renderQuestion(); }
  else { renderQuestion(); } // may show done banner
});

// ── Toggle quiz dock ──────────────────────────────────────────────
toggleBtn.addEventListener('click', () => {
  dockOpen = !dockOpen;
  dock.hidden = !dockOpen;
  toggleLabel.textContent = dockOpen ? '✕ Close' : '📋 Quests';
  document.body.classList.toggle('bbo-mode', dockOpen);
});

// ── Nav buttons ───────────────────────────────────────────────────
prevBtn.addEventListener('click', () => { if (current > 0) { current--; renderQuestion(); } });
nextBtn.addEventListener('click', () => { if (current < nodes.length - 1) { current++; renderQuestion(); } });

// ── Hint ─────────────────────────────────────────────────────────
hintBtn.addEventListener('click', () => {
  hintText.hidden = !hintText.hidden;
  hintBtn.textContent = hintText.hidden ? '💡 Hint' : '💡 Hide Hint';
});

// ── Share bonus ───────────────────────────────────────────────────
async function handleShare(url: string) {
  if (!shareNode || shareNode.completed || !supabase) return;
  // Optimistically disable buttons to prevent double-submission
  shareNode.completed = true;
  [shareLinkedIn, shareTwitter, shareCopy].forEach(b => { b.disabled = true; });
  // Open the share URL
  if (url) window.open(url, '_blank', 'noopener');
  // Award EXP via submit_answer with hash("shared")
  const h = await hashAnswer('shared');
  const { data, error } = await supabase.rpc('submit_answer', {
    p_nickname:    nickname,
    p_node_id:     shareNode.id,
    p_answer_hash: h,
  });
  if (error || !data?.ok) {
    // Roll back optimistic disable on network failure
    shareNode.completed = false;
    [shareLinkedIn, shareTwitter, shareCopy].forEach(b => { b.disabled = false; });
    return;
  }
  if (data.correct || data.already_completed) {
    // Buttons already disabled above
    shareClaimed.hidden = false;
    shareBanner.hidden = true;
    // Update HUD
    if (data.new_exp !== undefined) {
      updateHudDisplay(data.new_exp, data.new_level, nickname);
      try {
        const cached = localStorage.getItem('ex-profile');
        if (cached) {
          const p = JSON.parse(cached);
          p.exp   = data.new_exp;
          p.level = data.new_level;
          localStorage.setItem('ex-profile', JSON.stringify(p));
        }
      } catch (_) {}
    }
    if (data.story_fragment) {
      const sf = data.story_fragment;
      showStory(sf.title, sf.body, sf.type, shareNode.exp_reward);
    }
  }
}

// ── Copy link helper ──────────────────────────────────────────────
async function copyAndShare() {
  try { await navigator.clipboard.writeText(window.location.href); } catch (_) {}
  await handleShare('');
}

// ── Init ──────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', async () => {
  // Check if explorer session exists
  let profile: any = null;
  try {
    const cached = localStorage.getItem('ex-profile');
    if (cached) profile = JSON.parse(cached);
  } catch (_) {}

  nickname = (profile?.nickname) || '';
  if (!nickname || !supabase) return; // not in explorer mode

  // Show HUD
  hud.hidden = false;
  hud.removeAttribute('hidden');
  updateHudDisplay(profile.exp ?? 0, profile.level ?? 1, nickname);

  // Show share section
  shareSection.hidden = false;

  // Fetch quiz content
  const { data, error } = await supabase.rpc('get_project_content', {
    p_project_slug: 'boulder-box-saigon',
    p_nickname:     nickname,
  });

  if (error || !data?.ok || !data.nodes?.length) return;

  const allNodes = data.nodes as QuizNode[];
  // Separate quiz nodes (dock) from the share puzzle node
  nodes     = allNodes.filter(n => n.node_type === 'quiz');
  shareNode = allNodes.find(n => n.node_type === 'puzzle') ?? null;

  // If share already claimed, reflect that in UI
  if (shareNode?.completed) {
    [shareLinkedIn, shareTwitter, shareCopy].forEach(b => { b.disabled = true; });
    shareClaimed.hidden = false;
  }

  // Wire share buttons
  const pageUrl  = encodeURIComponent(window.location.href);
  const pageTitle = encodeURIComponent('Boulder Box Saigon — Portfolio Case Study');
  shareLinkedIn.addEventListener('click', () =>
    handleShare(`https://www.linkedin.com/sharing/share-offsite/?url=${pageUrl}`));
  shareTwitter.addEventListener('click', () =>
    handleShare(`https://x.com/intent/post?text=${pageTitle}&url=${pageUrl}`));
  shareCopy.addEventListener('click', copyAndShare);

  // Find first incomplete quiz question
  const firstIncomplete = nodes.findIndex(n => !n.completed);
  current = firstIncomplete === -1 ? 0 : firstIncomplete;

  updateProgressBadge();

  // Open dock if there are incomplete quests
  const hasPending = nodes.some(n => !n.completed);
  if (hasPending) {
    dockOpen = true;
    dock.hidden = false;
    dock.removeAttribute('hidden');
    toggleLabel.textContent = '✕ Close';
    document.body.classList.add('bbo-mode');
  }

  // Show share banner if quiz done but share not claimed
  if (!hasPending && shareNode && !shareNode.completed) {
    shareBanner.hidden = false;
  }

  renderQuestion();
});
</script>
