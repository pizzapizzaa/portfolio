---
// Explorer onboarding cinematic page
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Explorer Mode onboarding sequence" />
  <title>Explorer Onboarding - Olivia Nguyen</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Exo+2:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg:         #05090e;
      --bg-panel:   rgba(10,22,30,0.93);
      --border:     #2F8986;
      --border-hi:  #92D34F;
      --accent:     #92D34F;
      --accent-hi:  #D3ED66;
      --text-1:     #F7FFC7;
      --text-2:     #7db05a;
      --text-muted: #3a6a3a;
      --glow:       rgba(146,211,79,0.32);
      --glow-teal:  rgba(47,137,134,0.38);
    }

    * { box-sizing: border-box; }

    html,
    body {
      margin: 0;
      height: 100%;
      font-family: 'Exo 2', sans-serif;
      background: #000;
      color: var(--text-1);
      overflow: hidden;
    }

    .onboard-root {
      position: relative;
      width: 100vw;
      height: 100vh;
      background:
        radial-gradient(ellipse at 50% 115%, rgba(18, 65, 40, 0.3) 0%, rgba(0, 0, 0, 0) 55%),
        #000;
      animation: spaceLift 1.2s ease-out forwards;
    }

    .scene-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      pointer-events: none;
    }

    .space-fade {
      animation: pitchToSpace 1.4s ease forwards;
      transform-origin: center;
    }

    .star {
      fill: #9bc7ff;
      opacity: 0;
      animation: twinkle 2.8s ease-in-out infinite;
    }

    .star.s1 { animation-delay: 0.4s; }
    .star.s2 { animation-delay: 0.9s; }
    .star.s3 { animation-delay: 1.5s; }
    .star.s4 { animation-delay: 2.1s; }

    .brief-image-wrap {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      z-index: 0;
      transform: translateY(-20%);
    }

    .brief-image {
      width: min(760px, 84vw);
      height: auto;
      max-height: 60vh;
      border-radius: 14px;
      box-shadow: 0 28px 60px rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(146, 211, 79, 0.25);
      opacity: 0;
      animation: panelOpen 0.9s 1.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      object-fit: contain;
    }

    .brief-image.hidden {
      opacity: 0;
      visibility: hidden;
    }

    .pre-screen {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      background: radial-gradient(circle at 50% 20%, rgba(9, 26, 22, 0.65), rgba(0, 0, 0, 0.85));
      z-index: 3;
      pointer-events: auto;
      transition: opacity 0.4s ease;
    }

    .pre-screen.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .email-chip {
      width: min(520px, 86vw);
      padding: 18px 20px;
      border-radius: 12px;
      border: 1px solid rgba(146, 211, 79, 0.4);
      background: rgba(5, 13, 19, 0.8);
      box-shadow: 0 0 24px rgba(146, 211, 79, 0.2);
      font-family: 'Orbitron', monospace;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 12px;
      text-align: center;
      color: var(--accent-hi);
    }

    .email-anim {
      width: 160px;
      height: 120px;
      position: relative;
    }

    .email-anim .envelope {
      position: absolute;
      inset: 0;
      border: 2px solid rgba(146, 211, 79, 0.7);
      border-radius: 8px;
      overflow: hidden;
      background: #05090e;
    }

    .email-anim .envelope::before,
    .email-anim .envelope::after {
      content: '';
      position: absolute;
      inset: 0;
      border-left: 2px solid rgba(146, 211, 79, 0.5);
      border-right: 2px solid rgba(146, 211, 79, 0.5);
      transform: skewY(-22deg);
    }

    .email-anim .envelope::after {
      transform: skewY(22deg);
    }

    .email-anim .scan-bars {
      position: absolute;
      left: 16px;
      right: 16px;
      top: 20px;
      height: 8px;
      border-radius: 4px;
      background: linear-gradient(90deg, rgba(146, 211, 79, 0.1), rgba(146, 211, 79, 0.9), rgba(146, 211, 79, 0.1));
      animation: emailPulse 1.6s ease-in-out infinite;
    }

    .email-anim .scan-bars:nth-child(2) {
      top: 50px;
      animation-delay: 0.3s;
    }

    .email-anim .scan-bars:nth-child(3) {
      top: 80px;
      animation-delay: 0.6s;
    }

    .scanline {
      opacity: 0;
      animation: scanIn 1.2s 2.4s ease forwards;
    }

    .hud-overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 24px;
      pointer-events: none;
      z-index: 2;
    }

    .message-card {
      pointer-events: auto;
      margin: 0 auto;
      width: min(900px, calc(100vw - 32px));
      background: linear-gradient(160deg, rgba(6, 18, 15, 0.95), rgba(4, 12, 22, 0.92));
      border: 1px solid var(--border);
      box-shadow: 0 0 26px var(--glow-teal), inset 0 0 40px rgba(7, 26, 20, 0.45);
      border-radius: 12px;
      padding: 18px 20px;
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
    }

    .message-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }

    .message-tag {
      font-family: 'Orbitron', monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--accent);
    }

    .message-step {
      font-family: 'Orbitron', monospace;
      font-size: 10px;
      letter-spacing: 0.14em;
      color: var(--text-2);
    }

    .message-title {
      margin: 0 0 8px;
      font-family: 'Orbitron', monospace;
      font-size: clamp(18px, 2.3vw, 28px);
      font-weight: 800;
      letter-spacing: 0.05em;
      color: var(--accent-hi);
      text-transform: uppercase;
    }

    .message-body {
      margin: 0;
      line-height: 1.65;
      font-size: clamp(14px, 1.65vw, 18px);
      color: var(--text-1);
      min-height: 4.5em;
    }

    .control-row {
      pointer-events: auto;
      margin: 14px auto 0;
      width: min(900px, calc(100vw - 32px));
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .control-left,
    .control-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .btn {
      border: 1px solid var(--border);
      background: rgba(9, 21, 18, 0.9);
      color: var(--text-1);
      font-family: 'Orbitron', monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 10px 16px;
      clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
      cursor: pointer;
      transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
    }

    .btn:hover:not(:disabled) {
      transform: translateY(-1px);
      border-color: var(--border-hi);
      background: rgba(15, 34, 22, 0.96);
    }

    .btn:disabled {
      opacity: 0.35;
      cursor: default;
    }

    .btn.skip {
      color: #ffb4b4;
      border-color: rgba(255, 130, 130, 0.7);
      background: rgba(40, 9, 9, 0.85);
    }

    .btn.primary {
      color: #071207;
      background: var(--accent);
      border-color: var(--accent-hi);
      box-shadow: 0 0 14px var(--glow);
    }

    .btn.primary:hover:not(:disabled) {
      background: var(--accent-hi);
    }

    @keyframes pitchToSpace {
      from { filter: brightness(0); }
      to { filter: brightness(1); }
    }

    @keyframes spaceLift {
      from { background-color: #000; }
      to { background-color: #010305; }
    }

    @keyframes twinkle {
      0%, 100% { opacity: 0.18; transform: scale(0.9); }
      50% { opacity: 1; transform: scale(1.25); }
    }

    @keyframes lightOn {
      0% { opacity: 0; }
      55% { opacity: 0.65; }
      100% { opacity: 1; }
    }

    @keyframes lightPulse {
      0% { opacity: 0; transform: scale(0.7); }
      70% { opacity: 0.95; transform: scale(1.06); }
      100% { opacity: 1; transform: scale(1); }
    }

    @keyframes emailPulse {
      0%, 100% { opacity: 0.25; transform: scaleX(0.8); }
      50% { opacity: 1; transform: scaleX(1); }
    }

    @keyframes panelOpen {
      from { opacity: 0; transform: translateY(40px) scale(0.94); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }

    @keyframes scanIn {
      0% { opacity: 0; transform: translateY(8px); }
      100% { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 780px) {
      .hud-overlay {
        padding: 10px 12px 16px;
        justify-content: flex-end;
        padding-bottom: max(16px, env(safe-area-inset-bottom));
        transform: translateY(-8%);
      }
      .brief-image-wrap {
        align-items: flex-start;
        padding-top: 48px;
        transform: none;
      }
      .brief-image {
        max-height: 36vh;
        width: 92vw;
      }
      .message-card {
        padding: 12px 14px;
      }
      .message-title {
        font-size: clamp(15px, 4.5vw, 22px);
        margin-bottom: 6px;
      }
      .message-body {
        font-size: clamp(13px, 3.8vw, 16px);
        min-height: unset;
      }
      .control-row {
        flex-direction: row;
        align-items: center;
        gap: 8px;
        margin-top: 10px;
      }
      .control-left,
      .control-right {
        display: contents;
      }
      .btn {
        width: auto;
        padding: 10px 8px;
        font-size: 10px;
      }
      .control-row .btn {
        flex: 1;
        min-width: 0;
      }
    }
  </style>
</head>
<body>
  <main class="onboard-root" aria-label="Explorer onboarding">
    <section class="pre-screen" id="preScreen" aria-live="polite">
      <div class="email-anim" aria-hidden="true">
        <div class="envelope"></div>
        <div class="scan-bars"></div>
        <div class="scan-bars"></div>
        <div class="scan-bars"></div>
      </div>
      <div class="email-chip">Incoming Transmission</div>
      <button class="btn primary" id="openMessageBtn" type="button">Open Message</button>
    </section>

    <svg class="scene-svg" viewBox="0 0 1440 900" role="img" aria-label="Deep-space onboarding scene">
      <defs>
        <radialGradient id="lightCone" cx="50%" cy="22%" r="48%">
          <stop offset="0%" stop-color="#d3ed66" stop-opacity="0.62" />
          <stop offset="58%" stop-color="#7bd95d" stop-opacity="0.2" />
          <stop offset="100%" stop-color="#000" stop-opacity="0" />
        </radialGradient>
        <linearGradient id="panelFill" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#0c1f18" stop-opacity="0.96" />
          <stop offset="100%" stop-color="#08131d" stop-opacity="0.94" />
        </linearGradient>
      </defs>

      <rect class="space-fade" x="0" y="0" width="1440" height="900" fill="#000" />

      <g>
        <circle class="star s1" cx="132" cy="118" r="2.2" />
        <circle class="star s2" cx="256" cy="246" r="1.8" />
        <circle class="star s3" cx="388" cy="100" r="2.4" />
        <circle class="star s4" cx="520" cy="215" r="1.6" />
        <circle class="star s1" cx="672" cy="124" r="2.1" />
        <circle class="star s2" cx="846" cy="205" r="1.8" />
        <circle class="star s3" cx="1024" cy="148" r="2.5" />
        <circle class="star s4" cx="1178" cy="244" r="2.1" />
        <circle class="star s1" cx="1306" cy="142" r="1.9" />
      </g>

    </svg>

    <div class="brief-image-wrap">
      <img class="brief-image hidden" id="briefImage" src="/assets/game-ui/city-scene-dwarf-star.jpg" alt="Mission brief scene" />
    </div>

    <section class="hud-overlay" id="hudOverlay">
      <article class="message-card" aria-live="polite" aria-atomic="true">
        <div class="message-top">
          <span class="message-tag">Incoming Transmission</span>
          <span class="message-step" id="stepIndicator">01 / 03</span>
        </div>
        <h1 class="message-title" id="messageTitle">Mission Brief</h1>
        <p class="message-body" id="messageBody">
          Ten and a half light-years from Earth, orbiting the orange dwarf star Epsilon Eridani, lies Aethelgard - a cold, metal-rich tundra world. Aethelgard is ruled by The Great Ledger, a planetary supercomputer network. Generations ago, the Ledger predicted The 10^-12 Variance: a mathematical certainty that without completely foreign, chaotic intellectual stimuli, Aethelgard's society would hit a permanent cognitive plateau and slowly decay into machine-tended stagnation over the next several millennia.
        </p>
      </article>

      <div class="control-row">
        <div class="control-left">
          <button class="btn skip" id="skipBtn" type="button">Skip</button>
        </div>
        <div class="control-right">
          <button class="btn" id="backBtn" type="button">Back</button>
          <button class="btn primary" id="nextBtn" type="button">Next</button>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    const initExplorerOnboard = () => {
      const steps = [
      {
        title: 'Mission Brief',
        body: 'Ten and a half light-years from Earth, orbiting the orange dwarf star Epsilon Eridani, lies Aethelgard - a cold, metal-rich tundra world. Aethelgard is ruled by The Great Ledger, a planetary supercomputer network. Generations ago, the Ledger predicted The 10^-12 Variance: a mathematical certainty that without completely foreign, chaotic intellectual stimuli, Aethelgard\'s society would hit a permanent cognitive plateau and slowly decay into machine-tended stagnation over the next several millennia.',
        image: '/assets/game-ui/city-scene-dwarf-star.jpg',
      },
      {
        title: 'Mission Brief',
        body: 'To save their future from this slow intellectual death, the Consensus launched Project Catalyst—sending advanced scouts across the stars to harvest "Cognitive Fragments" from external civilizations. These Fragments are bursts of alien knowledge, culture, and creativity that can be integrated into the Ledger to revitalize Aethelgard\'s intellectual ecosystem. Your team was assigned to go on a terrestrial life in space mission to collect proof of smart living objects in space.',
        image: '/assets/game-ui/mission_brief_page_2.jpg',
      },
      {
        title: 'Mission Brief',
        body: 'You landed on a pale blue planet with a rich, but fading atmosphere. This is Earth—now a semi-dead world. Centuries after an ecological collapse, its vast cities are swallowed by wild forests and dust. Only a few selective animal species roam the quiet ruins, alongside a scattering of small, nomadic human tribes living in the shell of their ancestors\' past. While surveying a crumbling, overgrown library, your scanners detected a series of localized data-caches. These fragmented intelligent information blocks were deliberately left behind, preserved in protective stasis fields. They wanted to be found.',
        image: '/assets/game-ui/mission_brief_page_3.jpg',
      },
      ];

      let index = 0;
      let isOpened = false;

      const preScreen = document.getElementById('preScreen');
      const openMessageBtn = document.getElementById('openMessageBtn');
      const hudOverlay = document.getElementById('hudOverlay');
      const briefImage = document.getElementById('briefImage');
      const stepIndicator = document.getElementById('stepIndicator');
      const messageTitle = document.getElementById('messageTitle');
      const messageBody = document.getElementById('messageBody');
      const backBtn = document.getElementById('backBtn');
      const nextBtn = document.getElementById('nextBtn');
      const skipBtn = document.getElementById('skipBtn');

      if (
        !preScreen ||
        !(openMessageBtn instanceof HTMLButtonElement) ||
        !hudOverlay ||
        !(briefImage instanceof HTMLImageElement) ||
        !stepIndicator ||
        !messageTitle ||
        !messageBody ||
        !(backBtn instanceof HTMLButtonElement) ||
        !(nextBtn instanceof HTMLButtonElement) ||
        !(skipBtn instanceof HTMLButtonElement)
      ) {
        console.error('Onboarding UI is missing required elements.');
        return;
      }

      function showMissionBrief() {
        isOpened = true;
        preScreen.classList.add('hidden');
        hudOverlay.style.opacity = '1';
        hudOverlay.style.pointerEvents = 'auto';
        briefImage.classList.remove('hidden');
        renderStep();
      }

      function renderStep() {
        const step = steps[index];
        messageTitle.textContent = step.title;
        messageBody.textContent = step.body;
        briefImage.src = step.image;
        stepIndicator.textContent = `${String(index + 1).padStart(2, '0')} / ${String(steps.length).padStart(2, '0')}`;

        backBtn.disabled = index === 0;
        nextBtn.textContent = index === steps.length - 1 ? 'Begin Mission' : 'Next';

        if (typeof messageBody.animate === 'function') {
          messageBody.animate(
            [
              { opacity: 0.45, transform: 'translateY(8px)' },
              { opacity: 1, transform: 'translateY(0)' },
            ],
            { duration: 260, easing: 'ease-out' }
          );
        }
      }

      function goToExplorerStart() {
        window.location.href = '/explorer_start';
      }

      openMessageBtn.addEventListener('click', () => {
        showMissionBrief();
      });

      backBtn.addEventListener('click', () => {
        if (!isOpened) return;
        if (index === 0) return;
        index -= 1;
        renderStep();
      });

      nextBtn.addEventListener('click', () => {
        if (!isOpened) return;
        if (index < steps.length - 1) {
          index += 1;
          renderStep();
          return;
        }
        goToExplorerStart();
      });

      skipBtn.addEventListener('click', () => {
        if (!isOpened) return;
        goToExplorerStart();
      });

      hudOverlay.style.opacity = '0';
      hudOverlay.style.pointerEvents = 'none';
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initExplorerOnboard);
    } else {
      initExplorerOnboard();
    }
  </script>
</body>
</html>
