---
import '../styles/global.css';
import Starfield from '../components/space/Starfield.astro';
import HudNav from '../components/space/HudNav.astro';
import ProgressRail from '../components/space/ProgressRail.astro';

interface Props {
  title: string;
  description?: string;
  /** Show the chapter progress rail (homepage only) */
  rail?: boolean;
}

const {
  title,
  description = 'Olivia Nguyen — product leader with 13+ years across product strategy, UX/UI design and software delivery.',
  rail = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05090e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/assets/game-ui/city-scene-dwarf-star.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;600;700;800;900&family=Exo+2:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      // Hide [data-reveal] content only when motion is allowed; if the motion bundle
      // fails to start within 3s, show everything anyway.
      (function () {
        var root = document.documentElement;
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion-ok');
          setTimeout(function () {
            if (!root.classList.contains('motion-ready')) root.classList.remove('motion-ok');
          }, 3000);
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Starfield />
    <HudNav />
    {rail && <ProgressRail />}
    <div id="main" tabindex="-1">
      <slot />
    </div>
  </body>
</html>

<script>
  import { startMotion } from '../scripts/motion';
  startMotion();
</script>
