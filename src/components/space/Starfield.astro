---
// Fixed full-screen canvas starfield: 3 parallax depth layers that drift with scroll
// and the mouse. Dispatch `space:warp` on window to stretch stars into streaks
// (used for page/zoom transitions). Static frame under prefers-reduced-motion.
---

<canvas id="starfield" class="starfield" aria-hidden="true"></canvas>
<div class="space-vignette" aria-hidden="true"></div>

<style>
  .starfield {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 18% 60%, rgba(47, 137, 134, 0.12) 0%, transparent 55%),
      radial-gradient(ellipse at 85% 12%, rgba(245, 58, 2, 0.08) 0%, transparent 45%),
      radial-gradient(ellipse at 60% 100%, rgba(146, 211, 79, 0.06) 0%, transparent 50%),
      var(--bg);
  }
  .space-vignette {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(ellipse at center, transparent 55%, rgba(0, 0, 0, 0.55) 100%);
  }
</style>

<script>
  const canvas = document.getElementById('starfield') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  interface Star { x: number; y: number; r: number; a: number; tw: number; hue: number; }
  // depth = parallax factor; nearer layers move more and are brighter
  const layers = [
    { depth: 0.08, count: 0.00018, size: [0.4, 0.9], stars: [] as Star[] },
    { depth: 0.2, count: 0.00008, size: [0.7, 1.3], stars: [] as Star[] },
    { depth: 0.45, count: 0.00003, size: [1.1, 1.9], stars: [] as Star[] },
  ];

  let w = 0, h = 0, dpr = 1;
  let mouseX = 0, mouseY = 0, curX = 0, curY = 0;
  let warp = 0;          // 0..1 streak amount
  let warpTarget = 0;
  let running = true;

  function seed() {
    for (const layer of layers) {
      const n = Math.round(w * h * layer.count);
      layer.stars = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: layer.size[0] + Math.random() * (layer.size[1] - layer.size[0]),
        a: 0.35 + Math.random() * 0.65,
        tw: Math.random() * Math.PI * 2,
        // mostly cream-white, a few teal/green/orange
        hue: Math.random() < 0.82 ? -1 : [170, 95, 18][Math.floor(Math.random() * 3)],
      }));
    }
  }

  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    w = window.innerWidth;
    h = window.innerHeight;
    canvas.width = w * dpr;
    canvas.height = h * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    seed();
    if (reduced) draw(0);
  }

  function draw(t: number) {
    ctx.clearRect(0, 0, w, h);
    const scroll = window.scrollY;
    curX += (mouseX - curX) * 0.05;
    curY += (mouseY - curY) * 0.05;
    warp += (warpTarget - warp) * 0.08;
    const cx = w / 2, cy = h / 2;

    for (const layer of layers) {
      const offY = (scroll * layer.depth) % h;
      const offX = curX * layer.depth * 40;
      const offMy = curY * layer.depth * 40;
      for (const s of layer.stars) {
        let x = s.x - offX;
        let y = s.y - offY - offMy;
        x = ((x % w) + w) % w;
        y = ((y % h) + h) % h;
        const twinkle = reduced ? 1 : 0.75 + 0.25 * Math.sin(t * 0.0015 + s.tw);
        const alpha = s.a * twinkle;
        const color = s.hue < 0
          ? `rgba(247,255,230,${alpha})`
          : `hsla(${s.hue},80%,65%,${alpha})`;

        if (warp > 0.02) {
          // streak away from centre
          const dx = x - cx, dy = y - cy;
          const len = warp * 0.35 * (1 + layer.depth * 3);
          ctx.strokeStyle = color;
          ctx.lineWidth = s.r;
          ctx.beginPath();
          ctx.moveTo(x, y);
          ctx.lineTo(x + dx * len, y + dy * len);
          ctx.stroke();
        } else {
          ctx.fillStyle = color;
          ctx.beginPath();
          ctx.arc(x, y, s.r, 0, Math.PI * 2);
          ctx.fill();
        }
      }
    }
  }

  function loop(t: number) {
    if (!running) return;
    draw(t);
    requestAnimationFrame(loop);
  }

  resize();
  window.addEventListener('resize', resize);

  if (!reduced) {
    window.addEventListener('pointermove', (e) => {
      mouseX = e.clientX / w - 0.5;
      mouseY = e.clientY / h - 0.5;
    }, { passive: true });

    window.addEventListener('space:warp', ((e: CustomEvent<{ duration?: number }>) => {
      warpTarget = 1;
      setTimeout(() => { warpTarget = 0; }, e.detail?.duration ?? 700);
    }) as EventListener);

    document.addEventListener('visibilitychange', () => {
      running = !document.hidden;
      if (running) requestAnimationFrame(loop);
    });

    requestAnimationFrame(loop);
  }
</script>
