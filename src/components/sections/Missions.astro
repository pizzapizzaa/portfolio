---
import { missions, domainColors } from '../../data/missions';

const domainLabel: Record<string, string> = {
  climate: 'Climate tech',
  fintech: 'Fintech',
  community: 'Community',
  sport: 'Sport & lifestyle',
  consumer: 'Consumer',
};
const pad = (n: number) => String(n + 1).padStart(2, '0');
---

<section id="missions" class="section-shell missions" aria-labelledby="missions-title">
  <header class="chapter missions__head">
    <div>
      <p class="chapter__index">05 // Missions</p>
      <h2 id="missions-title" class="chapter__title" data-decode>Missions</h2>
      <p class="chapter__lead" data-reveal>Every project is a planet. Pick one to land and read the full mission report.</p>
    </div>
    <a href="#launch-pad" class="hud-btn missions__map-link" data-sfx="both" data-reveal>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="12" cy="12" r="3" /></svg>
      Star map
    </a>
  </header>

  <ul class="missions__grid">
    {missions.map((m, i) => (
      <li data-reveal>
        <a
          href={m.href}
          class:list={['mission', { 'mission--uncharted': m.status === 'uncharted' }]}
          style={`--c: ${domainColors[m.domain]}`}
          data-warp
          data-tilt
          data-sfx="hover"
        >
          <span class="mission__visual">
            <span class="mission__media">
              <img src={m.image} alt="" loading="lazy" />
              <span class="mission__scan" aria-hidden="true"></span>
            </span>
            <span class="mission__planet" aria-hidden="true"></span>
          </span>
          <span class="mission__body">
            <span class="mission__meta">
              <span class="mission__code">P-{pad(i)}</span>
              <span class="mission__domain">{domainLabel[m.domain]}</span>
              <span class="mission__status">{m.status === 'uncharted' ? 'Uncharted' : 'Charted'}</span>
            </span>
            <span class="mission__title">{m.title}</span>
            <span class="mission__desc">{m.description}</span>
            <span class="mission__foot">
              <span class="mission__role">{m.role}</span>
              <span class="mission__go">{m.status === 'uncharted' ? 'Approach' : 'Land'} →</span>
            </span>
          </span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .missions__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .missions__head > div { display: grid; gap: 14px; }
  .missions__map-link { flex-shrink: 0; }

  .missions__grid {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }
  .missions__grid > li { perspective: 1000px; }

  .mission {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
    background: linear-gradient(170deg, rgba(10, 26, 30, 0.85), rgba(5, 10, 16, 0.92));
    border: 1px solid var(--hairline);
    transform-style: preserve-3d;
    transition: border-color 0.3s, box-shadow 0.4s, transform 0.5s var(--ease-out);
  }
  .mission:hover,
  .mission:focus-visible {
    border-color: color-mix(in srgb, var(--c) 70%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 30%, transparent), 0 20px 50px -20px color-mix(in srgb, var(--c) 55%, transparent);
  }

  .mission__visual { position: relative; display: block; transform-style: preserve-3d; }
  .mission__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 8;
    overflow: hidden;
    border-bottom: 1px solid var(--hairline);
  }
  .mission__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.75) brightness(0.8);
    transform: scale(1.02);
    transition: transform 0.8s var(--ease-out), filter 0.5s;
  }
  .mission__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.2) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, transparent 40%, rgba(5, 10, 16, 0.9));
  }
  .mission:hover .mission__media img { transform: scale(1.08); filter: saturate(1) brightness(0.95); }
  .mission__scan {
    position: absolute;
    left: 0; right: 0; top: 0;
    z-index: 1;
    height: 35%;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--c) 40%, transparent), transparent);
    transform: translateY(-110%);
  }
  .mission:hover .mission__scan { animation: m-scan 1.1s var(--ease-out); }
  @keyframes m-scan { to { transform: translateY(300%); } }

  .mission__planet {
    position: absolute;
    right: 22px;
    bottom: -27px;
    z-index: 2;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 30%, color-mix(in srgb, var(--c) 35%, white) 0%, var(--c) 32%, color-mix(in srgb, var(--c) 45%, #02060a) 70%, #02060a 100%);
    box-shadow: inset -5px -7px 14px rgba(0, 0, 0, 0.65), 0 0 22px color-mix(in srgb, var(--c) 55%, transparent);
    transform: translateZ(30px);
    transition: transform 0.6s var(--ease-out);
  }
  .mission:hover .mission__planet { transform: translateY(-6px) translateZ(30px) rotate(25deg) scale(1.08); }

  .mission__body { display: flex; flex-direction: column; gap: 10px; flex: 1; padding: 22px 22px 22px; }
  .mission__meta { padding-right: 70px; }
  .mission__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }
  .mission__code { color: var(--signal-hi); }
  .mission__domain { color: var(--text-2); }
  .mission__status { margin-left: auto; padding: 1px 8px; border: 1px solid color-mix(in srgb, var(--c) 60%, transparent); color: var(--text-1); }
  .mission--uncharted .mission__status { border-color: var(--text-muted); color: rgba(247, 255, 199, 0.5); }
  .mission__title { font-family: var(--font-display); font-size: 18px; font-weight: 700; line-height: 1.3; letter-spacing: 0.03em; text-transform: uppercase; color: var(--text-1); }
  .mission__desc { font-size: 15px; line-height: 1.6; color: rgba(247, 255, 199, 0.72); }
  .mission__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px dashed var(--hairline);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .mission__role { color: var(--text-2); }
  .mission__go { color: var(--accent-hi); letter-spacing: 0.14em; text-transform: uppercase; transition: transform 0.3s var(--ease-out); }
  .mission:hover .mission__go { transform: translateX(4px); color: var(--signal-hi); }

  .mission--uncharted .mission__media img { filter: grayscale(0.8) brightness(0.5); }
  .mission--uncharted .mission__planet { filter: saturate(0.35) brightness(0.75); }

  @media (max-width: 860px) {
    .missions__grid { grid-template-columns: 1fr; }
    .missions__head { flex-direction: column; align-items: flex-start; }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';

  // Subtle 3D tilt toward the pointer
  if (!reducedMotion && matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        card.style.transform = `rotateY(${x * 6}deg) rotateX(${-y * 6}deg)`;
      });
      card.addEventListener('pointerleave', () => { card.style.transform = ''; });
    });
  }
</script>
