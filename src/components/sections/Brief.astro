---
import { profile } from '../../data/profile';
import { missions } from '../../data/missions';

const vitals = [
  { value: 13, suffix: '+', label: 'Years in product' },
  { value: missions.length, pad: 2, label: 'Missions logged' },
  { value: 4, pad: 2, label: 'Sectors: climate, fintech, mobility, sport' },
  { value: 15, label: 'Countries reached' },
];
---

<section id="brief" class="section-shell brief" aria-labelledby="brief-title">
  <header class="chapter">
    <p class="chapter__index">02 // Brief</p>
    <h2 id="brief-title" class="chapter__title" data-decode>Brief</h2>
    <p class="chapter__lead" data-reveal>Incoming transmission from the captain's quarters.</p>
  </header>

  <div class="brief__grid">
    <article class="hud-panel brief__tx" data-reveal>
      <div class="brief__tx-head">
        <span class="brief__rec" aria-hidden="true"></span>
        <span class="hud-label">Transmission // from O. Nguyen</span>
        <span class="hud-label brief__tx-enc">Enc: none</span>
      </div>
      <div class="brief__tx-body">
        {profile.summary.map((p) => <p>{p}</p>)}
      </div>
      <blockquote class="brief__quote">
        <p class="hud-label hud-label--signal">Captain's note</p>
        <p>“{profile.quote}”</p>
      </blockquote>
    </article>

    <aside class="brief__side">
      <div class="brief__oliv" data-reveal>
        <button type="button" class="brief__oliv-btn" data-oliv aria-label="Ask Oliv for another fact about Olivia" data-sfx="click">
          <img src="/assets/game-ui/oliv-the-mascot.png" alt="Oliv, the ship's robot mascot, waving" width="140" height="171" loading="lazy" />
        </button>
        <div class="brief__bubble" data-oliv-bubble aria-busy="false">
          <p class="hud-label">Oliv // ship AI</p>
          <p class="brief__bubble-text" data-oliv-text role="status" aria-live="polite" aria-atomic="true">Hi, I'm Oliv — the ship AI. Ask me for a random fact from the captain's current portfolio pages.</p>
          <a class="brief__bubble-source" data-oliv-source hidden>Read the source</a>
          <button type="button" class="brief__ask" data-oliv-ask data-sfx="click">Tell me something →</button>
        </div>
      </div>

      <dl class="brief__vitals">
        {vitals.map((v) => (
          <div class="brief__vital hud-panel" data-reveal>
            <dt class="hud-label">{v.label}</dt>
            <dd data-count={v.value} data-suffix={v.suffix} data-pad={v.pad}>
              {String(v.value).padStart(v.pad ?? 0, '0')}{v.suffix}
            </dd>
          </div>
        ))}
      </dl>
    </aside>
  </div>
</section>

<style>
  .brief__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 28px;
    align-items: start;
  }

  .brief__tx { padding: 28px 32px 32px; }
  .brief__tx-head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 16px;
    margin-bottom: 22px;
    border-bottom: 1px dashed var(--hairline);
  }
  .brief__tx-enc { margin-left: auto; color: var(--text-muted); }
  .brief__rec { width: 8px; height: 8px; border-radius: 50%; background: var(--signal); box-shadow: var(--shadow-glow-signal); animation: rec 1.4s steps(2) infinite; }
  @keyframes rec { 50% { opacity: 0.2; } }
  .brief__tx-body { display: grid; gap: 18px; color: rgba(247, 255, 199, 0.82); font-size: 17px; line-height: 1.75; }

  .brief__quote {
    margin: 28px 0 0;
    padding: 18px 22px;
    border-left: 2px solid var(--signal);
    background: linear-gradient(90deg, rgba(245, 58, 2, 0.1), transparent 80%);
  }
  .brief__quote p:last-child {
    margin-top: 8px;
    font-size: 19px;
    font-weight: 600;
    line-height: 1.55;
    color: var(--text-1);
  }

  .brief__side { display: grid; gap: 18px; }

  .brief__oliv { display: grid; grid-template-columns: 120px minmax(0, 1fr); align-items: start; gap: 20px; }
  .brief__oliv-btn {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    animation: oliv-float 4s ease-in-out infinite;
  }
  .brief__oliv-btn img { width: 120px; height: auto; filter: drop-shadow(0 0 18px rgba(65, 183, 116, 0.45)); transition: transform 0.4s var(--ease-out); }
  .brief__oliv-btn:hover img { transform: rotate(-6deg) scale(1.05); }
  .brief__oliv-btn.is-talking img { animation: oliv-wave 0.5s ease-in-out 2; }
  @keyframes oliv-float { 0%, 100% { translate: 0 0; } 50% { translate: 0 -8px; } }
  @keyframes oliv-wave { 0%, 100% { transform: rotate(0); } 30% { transform: rotate(-9deg); } 70% { transform: rotate(7deg); } }

  .brief__bubble {
    position: relative;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 22px 22px 22px 6px;
    background: #0a1c22;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2);
  }
  .brief__bubble::before {
    content: '';
    position: absolute;
    left: -9px;
    top: 34px;
    width: 16px;
    height: 16px;
    background: #0a1c22;
    border-left: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    transform: rotate(45deg);
  }
  .brief__bubble-text { margin-top: 10px; font-size: 15px; line-height: 1.65; color: var(--text-1); min-height: 4.65em; overflow-wrap: anywhere; }
  .brief__bubble-source { display: block; margin-top: 14px; font-size: 12px; color: var(--accent); text-underline-offset: 3px; overflow-wrap: anywhere; }
  .brief__bubble-source[hidden] { display: none; }
  .brief__ask { margin-top: 16px; padding: 0; border: 0; background: none; color: var(--accent-hi); font: inherit; font-size: 13px; text-align: left; cursor: pointer; }
  .brief__ask:hover { text-decoration: underline; text-underline-offset: 3px; }
  .brief__ask:disabled, .brief__oliv-btn:disabled { cursor: wait; opacity: 0.65; }

  .brief__vitals { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0; }
  .brief__vital { padding: 16px 18px; display: flex; flex-direction: column-reverse; gap: 6px; }
  .brief__vital dt { font-size: 10px; letter-spacing: 0.16em; line-height: 1.5; }
  .brief__vital dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(30px, 3.2vw, 42px);
    font-weight: 800;
    line-height: 1;
    color: var(--accent-hi);
    text-shadow: var(--text-glow);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 900px) {
    .brief__grid { grid-template-columns: 1fr; }
    .brief__tx { padding: 22px 20px 24px; }
    .brief__tx-body { font-size: 16px; }
  }
  @media (max-width: 420px) {
    .brief__oliv { grid-template-columns: 92px 1fr; }
    .brief__oliv-btn img { width: 92px; }
  }
</style>

<script>
  import { reducedMotion } from '../../scripts/motion';
  import { createOlivReader } from '../../lib/oliv';

  const btn = document.querySelector<HTMLButtonElement>('[data-oliv]')!;
  const ask = document.querySelector<HTMLButtonElement>('[data-oliv-ask]')!;
  const bubble = document.querySelector<HTMLElement>('[data-oliv-bubble]')!;
  const text = document.querySelector<HTMLElement>('[data-oliv-text]')!;
  const source = document.querySelector<HTMLAnchorElement>('[data-oliv-source]')!;
  const nextFact = createOlivReader();

  async function askOliv() {
    if (btn.disabled) return;
    btn.disabled = true;
    ask.disabled = true;
    bubble.setAttribute('aria-busy', 'true');
    source.hidden = true;
    text.textContent = 'Scanning the current portfolio pages…';
    try {
      const fact = await nextFact();
      text.textContent = fact.text;
      source.href = fact.href;
      source.textContent = `Source: ${fact.source} →`;
      source.hidden = false;
      ask.textContent = 'Tell me another →';
      if (!reducedMotion) {
        btn.classList.remove('is-talking');
        void btn.offsetWidth;
        btn.classList.add('is-talking');
      }
    } catch (error) {
      console.error('Oliv could not read the portfolio:', error);
      text.textContent = "I couldn't read the portfolio pages just now. Please try again.";
      ask.textContent = 'Try again →';
    } finally {
      btn.disabled = false;
      ask.disabled = false;
      bubble.setAttribute('aria-busy', 'false');
    }
  }

  btn.addEventListener('click', askOliv);
  ask.addEventListener('click', askOliv);
</script>
