---
import { profile, comms } from '../../data/profile';
import { EXPLORER_ENABLED } from '../../data/features';

const channels = [
  { code: 'CH-01', name: 'Email', value: comms.email, href: `mailto:${comms.email}`, copy: comms.email },
  { code: 'CH-02', name: 'LinkedIn', value: comms.linkedin.label, href: comms.linkedin.href, external: true },
  ...comms.phones.map((p, i) => ({ code: `CH-0${3 + i}`, name: i === 0 ? 'Phone · SG' : 'Phone · VN', value: p.label, href: p.href, copy: p.label })),
  { code: `CH-0${3 + comms.phones.length}`, name: 'Instagram', value: comms.instagram.label, href: comms.instagram.href, external: true },
];
const year = new Date().getFullYear();
---

<section id="comms" class="section-shell comms" aria-labelledby="comms-title">
  <header class="chapter">
    <p class="chapter__index">06 // Comms</p>
    <h2 id="comms-title" class="chapter__title" data-decode>Comms</h2>
    <p class="chapter__lead" data-reveal>Open a channel. Based in {profile.location}, working across time zones.</p>
  </header>

  <div class="comms__grid">
    <div class="comms__console hud-panel" data-reveal>
      <div class="comms__console-head">
        <span class="hud-label">Channel select</span>
        <span class="comms__wave" aria-hidden="true">
          {Array.from({ length: 18 }, (_, i) => <span style={`--i:${i}`}></span>)}
        </span>
      </div>
      <ul class="comms__channels">
        {channels.map((c) => (
          <li class="comms__channel">
            <span class="comms__code">{c.code}</span>
            <span class="comms__name">{c.name}</span>
            <a
              href={c.href}
              class="comms__value"
              target={c.external ? '_blank' : undefined}
              rel={c.external ? 'noopener' : undefined}
              data-sfx="both"
            >{c.value}{c.external && ' ↗'}</a>
            {c.copy && (
              <button type="button" class="comms__copy" data-copy={c.copy} aria-label={`Copy ${c.name}`} data-sfx="hover">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="1" /><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3" /></svg>
              </button>
            )}
          </li>
        ))}
      </ul>
    </div>

    <div class="comms__manifest hud-panel" data-reveal>
      <p class="hud-label hud-label--signal">Flight manifest</p>
      <h3 class="comms__manifest-title">Download the full CV</h3>
      <p class="comms__manifest-text">Complete service record — roles, outcomes, education and certifications — in one document.</p>
      <a href={profile.cvUrl} target="_blank" rel="noopener" class="hud-btn hud-btn--signal" data-sfx="both">
        <svg viewBox="0 0 256 256" aria-hidden="true"><path d="M224 144v64a8 8 0 0 1-8 8H40a8 8 0 0 1-8-8v-64a8 8 0 0 1 16 0v56h160v-56a8 8 0 0 1 16 0Zm-101.66 5.66a8 8 0 0 0 11.32 0l40-40a8 8 0 0 0-11.32-11.32L136 124.69V32a8 8 0 0 0-16 0v92.69l-26.34-26.35a8 8 0 0 0-11.32 11.32Z" /></svg>
        Download CV
      </a>
      {EXPLORER_ENABLED && <a href="/explorer_onboard" class="comms__explorer" data-sfx="both">
        <span class="comms__explorer-dot" aria-hidden="true"></span>
        Prefer to play? Enter explorer mode →
      </a>}
    </div>
  </div>

  <footer class="comms__footer">
    <span class="hud-label">End of transmission</span>
    <span class="comms__footer-line" aria-hidden="true"></span>
    <span class="comms__footer-copy">© {year} {profile.name}</span>
    <a href="#launch-pad" class="comms__top" data-sfx="both">Return to launch pad ↑</a>
  </footer>

  <div class="comms__toast" role="status" aria-live="polite" data-toast hidden></div>
</section>

<style>
  .comms { padding-bottom: 56px; }
  .comms__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 24px; align-items: stretch; }

  .comms__console { padding: 22px 26px; }
  .comms__console-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--hairline);
  }
  .comms__wave { display: flex; align-items: center; gap: 3px; height: 22px; }
  .comms__wave span {
    width: 2px;
    height: 100%;
    background: var(--accent);
    opacity: 0.7;
    transform-origin: center;
    animation: wave-bar 1.2s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.09s);
  }
  @keyframes wave-bar { 0%, 100% { transform: scaleY(0.15); } 50% { transform: scaleY(1); } }

  .comms__channels { list-style: none; margin: 0; padding: 0; }
  .comms__channel {
    display: grid;
    grid-template-columns: 52px 110px minmax(0, 1fr) auto;
    align-items: center;
    gap: 12px;
    min-height: 58px;
    border-bottom: 1px dashed var(--hairline);
    transition: background 0.2s;
  }
  .comms__channel:last-child { border-bottom: 0; }
  .comms__channel:hover { background: linear-gradient(90deg, rgba(146, 211, 79, 0.06), transparent); }
  .comms__code { font-family: var(--font-mono); font-size: 11px; color: var(--signal-hi); }
  .comms__name { font-family: var(--font-display); font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-2); }
  .comms__value {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 16px;
    text-decoration: none;
    color: var(--text-1);
    transition: color 0.2s, text-shadow 0.2s;
  }
  .comms__value:hover { color: var(--accent-hi); text-shadow: var(--text-glow); }
  .comms__copy {
    display: grid;
    place-items: center;
    width: 34px; height: 34px;
    padding: 0;
    color: var(--text-1);
    background: none;
    border: 1px solid var(--hairline);
    cursor: pointer;
    transition: border-color 0.2s, color 0.2s;
  }
  .comms__copy:hover { border-color: var(--accent); color: var(--accent-hi); }
  .comms__copy svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.7; }

  .comms__manifest {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 28px;
    background:
      radial-gradient(circle at 100% 0%, rgba(245, 58, 2, 0.16), transparent 55%),
      linear-gradient(160deg, rgba(10, 26, 30, 0.82), rgba(5, 12, 18, 0.88));
  }
  .comms__manifest-title { font-size: 22px; font-weight: 700; text-transform: uppercase; color: var(--text-1); }
  .comms__manifest-text { color: rgba(247, 255, 199, 0.72); font-size: 15px; }
  .comms__manifest .hud-btn { margin-top: 6px; }
  .comms__explorer {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding-top: 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-2);
    text-decoration: none;
  }
  .comms__explorer:hover { color: var(--accent-hi); }
  .comms__explorer-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 8px var(--accent); }

  .comms__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 96px;
    padding-top: 22px;
    border-top: 1px solid var(--hairline);
  }
  .comms__footer-line { flex: 1; height: 1px; min-width: 40px; background: linear-gradient(90deg, var(--signal), transparent); }
  .comms__footer-copy { font-family: var(--font-mono); font-size: 12px; color: rgba(247, 255, 199, 0.5); }
  .comms__top { font-family: var(--font-mono); font-size: 12px; color: var(--accent); text-decoration: none; }
  .comms__top:hover { color: var(--accent-hi); }

  .comms__toast {
    position: fixed;
    left: 50%;
    bottom: 28px;
    z-index: 300;
    padding: 12px 18px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bg);
    background: var(--accent);
    box-shadow: var(--shadow-glow-ui);
    transform: translateX(-50%);
    animation: toast 2.2s var(--ease-out) forwards;
  }
  .comms__toast[hidden] { display: none; }
  @keyframes toast {
    0% { opacity: 0; transform: translate(-50%, 12px); }
    12%, 80% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, 0); }
  }

  @media (max-width: 900px) {
    .comms__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .comms__console { padding: 16px; }
    .comms__channel { grid-template-columns: 1fr auto; grid-template-rows: auto auto; gap: 2px 10px; padding: 12px 0; }
    .comms__code { display: none; }
    .comms__name { grid-column: 1; }
    .comms__value { grid-column: 1; grid-row: 2; font-size: 15px; }
    .comms__copy { grid-column: 2; grid-row: 1 / span 2; }
    .comms__footer-line { display: none; }
  }
</style>

<script>
  import { play } from '../../scripts/sound';

  const toast = document.querySelector<HTMLElement>('[data-toast]')!;
  let timer: number | undefined;

  function showToast(msg: string) {
    toast.hidden = true;
    void toast.offsetWidth; // restart animation
    toast.textContent = msg;
    toast.hidden = false;
    clearTimeout(timer);
    timer = window.setTimeout(() => { toast.hidden = true; }, 2300);
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        play('confirm');
        showToast('Signal copied to clipboard');
      } catch {
        showToast('Copy failed — select the text instead');
      }
    });
  });
</script>
