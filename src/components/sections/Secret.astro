---
import { profile } from '../../data/profile';

const photos = [
  { src: '/assets/hobbies/climbing-01.jpg', alt: 'Laughing at the bouldering gym, climbing shoes in hand', tag: 'Climb' },
  { src: '/assets/hobbies/climbing-02.jpg', alt: 'Working a move on an overhanging bouldering wall', tag: 'Climb' },
  { src: '/assets/hobbies/climbing-03.jpg', alt: 'Hanging from the holds mid-route on a steep wall', tag: 'Climb' },
  { src: '/assets/hobbies/crochet-01.jpg', alt: 'Granny-square crochet work in progress with light blue yarn', tag: 'Crochet' },
  { src: '/assets/hobbies/crochet-02.jpg', alt: 'Crocheting on the couch with a case full of yarn', tag: 'Crochet' },
];
const year = new Date().getFullYear();
---

<section id="secret" class="section-shell secret" aria-labelledby="secret-title">
  <div class="secret__panel hud-panel" data-reveal>
    <p class="hud-label hud-label--signal">Classified // off the record</p>
    <h2 id="secret-title" class="secret__title" data-decode>Shhh!</h2>
    <p class="secret__text">
      I'm also a climber and a crocheter. Ping me for an after work climb or a coffee &amp; crochet weekend hang out.
    </p>
  </div>

  <ul class="secret__gallery" data-reveal>
    {photos.map((p) => (
      <li class="secret__shot">
        <img src={p.src} alt={p.alt} loading="lazy" decoding="async" />
        <span class="secret__tag hud-label">{p.tag}</span>
      </li>
    ))}
  </ul>

  <footer class="secret__footer">
    <span class="hud-label">End of transmission</span>
    <span class="secret__footer-line" aria-hidden="true"></span>
    <span class="secret__footer-copy">© {year} {profile.name}</span>
    <a href="#launch-pad" class="secret__top" data-sfx="both">Return to launch pad ↑</a>
  </footer>
</section>

<style>
  .secret { padding-top: 0; }

  .secret__panel {
    display: grid;
    gap: 12px;
    padding: 26px 28px;
    margin-bottom: 28px;
  }
  .secret__title {
    font-size: clamp(26px, 4vw, 44px);
    font-weight: 800;
    text-transform: uppercase;
    color: var(--text-1);
  }
  .secret__text {
    color: rgba(247, 255, 199, 0.72);
    font-size: 16px;
    line-height: 1.6;
  }

  .secret__gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 14px;
  }
  .secret__shot {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--hairline);
    aspect-ratio: 3 / 4;
  }
  .secret__shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s var(--ease-out), filter 0.5s;
    filter: saturate(0.9);
  }
  .secret__shot:hover img {
    transform: scale(1.05);
    filter: saturate(1.05);
  }
  .secret__tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 4px 8px;
    background: rgba(5, 12, 18, 0.72);
    border: 1px solid var(--hairline);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .secret__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 96px;
    padding-top: 22px;
    border-top: 1px solid var(--hairline);
  }
  .secret__footer-line { flex: 1; height: 1px; min-width: 40px; background: linear-gradient(90deg, var(--signal), transparent); }
  .secret__footer-copy { font-family: var(--font-mono); font-size: 12px; color: rgba(247, 255, 199, 0.5); }
  .secret__top { font-family: var(--font-mono); font-size: 12px; color: var(--accent); text-decoration: none; }
  .secret__top:hover { color: var(--accent-hi); }

  @media (max-width: 900px) {
    .secret__gallery { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .secret__panel { padding: 18px; }
    .secret__gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .secret__footer-line { display: none; }
  }
</style>
